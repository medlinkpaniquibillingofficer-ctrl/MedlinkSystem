@model MedlinkDialysisCenter.Models.Patient

@{
    ViewData["Title"] = "Cancel Patient";
}

<!-- Header -->
<div class="flex items-center gap-3.5 mb-7">
    <a asp-action="Index"
       class="inline-flex items-center justify-center w-9 h-9 rounded-xl border-[1.5px] border-gray-200 bg-white text-gray-500 no-underline hover:border-blue-500 hover:text-blue-600 hover:bg-blue-50 transition-all">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 12H5M12 5l-7 7 7 7" /></svg>
    </a>
    <div>
        <h1 class="text-2xl font-semibold tracking-tight m-0">Cancel Patient</h1>
        <p class="text-sm text-gray-500 mt-0.5">This patient will be moved to Cancelled Patients</p>
    </div>
</div>

<div class="max-w-lg">
    <div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden">

        <!-- Warning Banner -->
        <div class="bg-amber-50 border-b border-amber-200 px-6 py-4 flex items-start gap-3">
            <div class="w-9 h-9 rounded-full bg-amber-100 flex items-center justify-center text-amber-600 flex-shrink-0">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /><line x1="12" y1="9" x2="12" y2="13" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg>
            </div>
            <div>
                <div class="text-sm font-semibold text-amber-700 mb-1">Cancel this patient?</div>
                <div class="text-sm text-amber-600 leading-relaxed">This patient will be hidden from the active list, but their record will be kept and can be restored anytime from Cancelled Patients.</div>
            </div>
        </div>

        <!-- Patient Preview -->
        <div class="px-6 py-5 border-b border-gray-100">
            <div class="text-[10px] font-semibold text-gray-400 uppercase tracking-wider mb-3">Patient to be cancelled</div>
            <div class="flex items-center gap-3 mb-4">
                <div class="w-11 h-11 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center text-base font-semibold flex-shrink-0">
                    @Model.FirstName[0]@Model.LastName[0]
                </div>
                <div>
                    <div class="text-base font-semibold text-gray-900">@Model.FullName</div>
                    <div class="text-xs text-gray-400 font-mono">#@Model.PatientId.ToString("D4")</div>
                </div>
            </div>
            <div class="grid grid-cols-2 gap-2.5">
                <div class="text-sm text-gray-500">Gender: <span class="text-gray-800 font-medium">@(Model.Gender ?? "—")</span></div>
                <div class="text-sm text-gray-500">Contact: <span class="text-gray-800 font-medium">@(Model.ContactNo ?? "—")</span></div>
                <div class="text-sm text-gray-500">PhilHealth: <span class="text-gray-800 font-medium">@(Model.PhilhealthNo ?? "—")</span></div>
                <div class="text-sm text-gray-500">Registered: <span class="text-gray-800 font-medium">@Model.CreatedAt.ToString("MMM dd, yyyy")</span></div>
            </div>
        </div>

        <!-- Actions -->
        <div class="px-6 py-4 bg-gray-50 flex items-center justify-end gap-2.5">
            <a asp-action="Index"
               class="inline-flex items-center px-4 py-2.5 rounded-xl border-[1.5px] border-gray-200 bg-white text-sm font-medium text-gray-500 no-underline hover:text-gray-800 hover:border-gray-400 transition-all">
                Cancel
            </a>
            <form asp-action="Delete" method="post" style="margin:0">
                <input type="hidden" asp-for="PatientId" />
                <button type="submit"
                        class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-xl bg-amber-600 text-white text-sm font-medium hover:bg-amber-700 transition-colors shadow-sm border-none cursor-pointer">
                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6" /><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" /><path d="M10 11v6M14 11v6" /></svg>
                    Yes, Cancel Patient
                </button>
            </form>
        </div>
    </div>
</div>