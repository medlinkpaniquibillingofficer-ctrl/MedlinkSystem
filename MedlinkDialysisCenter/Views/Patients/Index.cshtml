@model IEnumerable<MedlinkDialysisCenter.Models.Patient>

@{
    ViewData["Title"] = "Patients";
}

<!-- Header -->
<div class="flex items-center justify-between mb-7 pt-1">
    <div>
        <h1 class="text-2xl font-semibold tracking-tight m-0">Patients</h1>
        <p class="text-sm text-gray-500 mt-1">Manage all registered dialysis patients</p>
    </div>
    <div class="flex items-center gap-2">
        <!-- Export Button -->
        <a asp-action="ExportToExcel"
           class="inline-flex items-center gap-1.5 bg-white text-gray-700 text-sm font-medium px-4 py-2.5 rounded-xl no-underline border-[1.5px] border-gray-200 hover:border-green-500 hover:text-green-600 hover:bg-green-50 transition-all shadow-sm">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                <polyline points="7 10 12 15 17 10" />
                <line x1="12" y1="15" x2="12" y2="3" />
            </svg>
            Export to Excel
        </a>
        <!-- Add Patient Button -->
        <a asp-action="Create"
           class="inline-flex items-center gap-1.5 bg-blue-600 text-white text-sm font-medium px-4 py-2.5 rounded-xl no-underline hover:bg-blue-700 transition-colors shadow-sm">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /></svg>
            Add Patient
        </a>
    </div>
</div>

<!-- Stat Cards -->
<div class="grid grid-cols-3 gap-4 mb-6">
    <div class="bg-white border border-gray-200 rounded-xl px-5 py-4 shadow-sm">
        <div class="text-xs text-gray-500 font-medium mb-1">Total Patients</div>
        <div class="text-2xl font-semibold tracking-tight text-blue-600">@Model.Count()</div>
    </div>
    <div class="bg-white border border-gray-200 rounded-xl px-5 py-4 shadow-sm">
        <div class="text-xs text-gray-500 font-medium mb-1">Active</div>
        <div class="text-2xl font-semibold tracking-tight text-green-600">@Model.Count()</div>
    </div>
    <div class="bg-white border border-gray-200 rounded-xl px-5 py-4 shadow-sm">
        <div class="text-xs text-gray-500 font-medium mb-1">Registered This Month</div>
        <div class="text-2xl font-semibold tracking-tight text-orange-500">@Model.Count(p => p.CreatedAt.Month == DateTime.Now.Month && p.CreatedAt.Year == DateTime.Now.Year)</div>
    </div>
</div>

<!-- Search -->
<div class="relative mb-5">
    <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.35-4.35" /></svg>
    <input type="text" id="searchInput" placeholder="Search by name, PhilHealth no, diagnosis..."
           class="w-full pl-10 pr-4 py-2.5 border-[1.5px] border-gray-200 rounded-xl text-sm focus:outline-none focus:border-blue-500 bg-white transition-colors" />
</div>

<!-- Table -->
<div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden">
    @if (!Model.Any())
    {
        <div class="text-center py-20">
            <div class="text-4xl mb-3 opacity-40">🏥</div>
            <div class="text-base font-medium text-gray-700 mb-1">No patients yet</div>
            <div class="text-sm text-gray-400">Add your first patient to get started.</div>
        </div>
    }
    else
    {
        <!-- Mirror scrollbar: lalabas lang kapag may overflow (split/minimized) -->
        <div id="topScrollbar" class="overflow-x-auto border-b border-gray-100" style="height: 0px; transition: height 0.15s ease;">
            <div id="topScrollbarSpacer" style="height: 1px;"></div>
        </div>

        <div id="tableScroll" class="overflow-x-auto">
            <table class="w-full min-w-[1000px]" id="patientTable">
                <thead>
                    <tr class="border-b border-gray-100 bg-gray-50">
                        <th class="text-left text-[11px] font-semibold uppercase tracking-wide text-gray-500 px-5 py-3 whitespace-nowrap">Patient</th>
                        <th class="text-left text-[11px] font-semibold uppercase tracking-wide text-gray-500 px-5 py-3 whitespace-nowrap">Gender</th>
                        <th class="text-left text-[11px] font-semibold uppercase tracking-wide text-gray-500 px-5 py-3 whitespace-nowrap">PhilHealth No.</th>
                        <th class="text-left text-[11px] font-semibold uppercase tracking-wide text-gray-500 px-5 py-3 whitespace-nowrap">Contact</th>
                        <th class="text-left text-[11px] font-semibold uppercase tracking-wide text-gray-500 px-5 py-3 whitespace-nowrap">Diagnosis</th>
                        <th class="text-left text-[11px] font-semibold uppercase tracking-wide text-gray-500 px-5 py-3 whitespace-nowrap">Nephrologist</th>
                        <th class="w-32 text-center text-[11px] font-semibold uppercase tracking-wide text-gray-500 px-5 py-3 whitespace-nowrap">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var patient in Model)
                    {
                        <tr class="border-b border-gray-100 last:border-0 hover:bg-slate-50 transition-colors">
                            <td class="px-5 py-4 whitespace-nowrap">
                                <div class="flex items-center gap-2.5">
                                    <div class="w-9 h-9 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center text-xs font-semibold flex-shrink-0">
                                        @patient.FirstName[0]@patient.LastName[0]
                                    </div>
                                    <div>
                                        <div class="text-sm font-medium text-gray-900">@patient.FullName</div>
                                        <div class="text-xs text-gray-400 font-mono">@patient.PatientCode</div>
                                    </div>
                                </div>
                            </td>
                            <td class="px-5 py-4 whitespace-nowrap">
                                @if (patient.Gender == "Male")
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-50 text-blue-700">Male</span>
                                }
                                else if (patient.Gender == "Female")
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-50 text-purple-700">Female</span>
                                }
                                else
                                {
                                    <span class="text-sm text-gray-400">@(patient.Gender ?? "—")</span>
                                }
                            </td>
                            <td class="px-5 py-4 whitespace-nowrap">
                                <span class="text-xs font-mono text-gray-500">@(patient.PhilhealthNo ?? "—")</span>
                            </td>
                            <td class="px-5 py-4 text-sm text-gray-600 whitespace-nowrap">@(patient.ContactNo ?? "—")</td>
                            <td class="px-5 py-4 text-sm text-gray-600 whitespace-nowrap">@(patient.Diagnosis ?? "—")</td>
                            <td class="px-5 py-4 text-sm text-gray-600 whitespace-nowrap">@(patient.Nephrologist ?? "—")</td>
                            <td class="w-32 px-5 py-4">
                                <div class="flex items-center justify-center gap-1.5">
                                    <a asp-action="Details" asp-route-id="@patient.PatientId"
                                       class="inline-flex items-center justify-center w-8 h-8 rounded-lg border-[1.5px] border-gray-200 bg-white text-gray-500 no-underline hover:border-blue-500 hover:text-blue-600 hover:bg-blue-50 transition-all">
                                        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                            <circle cx="12" cy="12" r="3" />
                                        </svg>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@patient.PatientId"
                                       class="inline-flex items-center justify-center w-8 h-8 rounded-lg border-[1.5px] border-gray-200 bg-white text-gray-500 no-underline hover:border-blue-500 hover:text-blue-600 hover:bg-blue-50 transition-all">
                                        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                                        </svg>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@patient.PatientId"
                                       class="inline-flex items-center justify-center w-8 h-8 rounded-lg border-[1.5px] border-gray-200 bg-white text-gray-500 no-underline hover:border-red-500 hover:text-red-600 hover:bg-red-50 transition-all">
                                        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                            <polyline points="3 6 5 6 21 6" />
                                            <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
                                            <path d="M10 11v6M14 11v6" />
                                            <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" />
                                        </svg>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<script>
    document.getElementById('searchInput')?.addEventListener('input', function () {
        const q = this.value.toLowerCase();
        document.querySelectorAll('#patientTable tbody tr').forEach(row => {
            row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none';
        });
    });

    const topScrollbar = document.getElementById('topScrollbar');
    const topScrollbarSpacer = document.getElementById('topScrollbarSpacer');
    const tableScroll = document.getElementById('tableScroll');
    const patientTable = document.getElementById('patientTable');

    function checkOverflow() {
        if (!patientTable || !tableScroll || !topScrollbar) return;

        const hasOverflow = patientTable.scrollWidth > tableScroll.clientWidth;

        // I-set ang spacer width para tama ang laki ng scrollbar thumb
        topScrollbarSpacer.style.width = patientTable.scrollWidth + 'px';

        // Lumalabas lang kapag may overflow; walang space kapag wala (maximized)
        topScrollbar.style.height = hasOverflow ? '16px' : '0px';
    }

    if (topScrollbar && tableScroll && patientTable) {
        checkOverflow();

        // I-recheck habang nag-resize ang window (e.g. pag-split o pag-maximize)
        window.addEventListener('resize', checkOverflow);

        // I-recheck rin kapag may ResizeObserver support (mas tumpak, sakop pati container resize na walang window resize event)
        if (window.ResizeObserver) {
            const ro = new ResizeObserver(checkOverflow);
            ro.observe(tableScroll);
        }

        topScrollbar.addEventListener('scroll', () => {
            tableScroll.scrollLeft = topScrollbar.scrollLeft;
        });
        tableScroll.addEventListener('scroll', () => {
            topScrollbar.scrollLeft = tableScroll.scrollLeft;
        });
    }
</script>

<script>
    document.getElementById('searchInput')?.addEventListener('input', function () {
        const q = this.value.toLowerCase();
        document.querySelectorAll('#patientTable tbody tr').forEach(row => {
            row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none';
        });
    });
</script>
