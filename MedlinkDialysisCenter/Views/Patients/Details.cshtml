@model MedlinkDialysisCenter.Models.Patient

@{
    ViewData["Title"] = "Patient Details";
}

<!-- Header -->
<div class="flex items-center justify-between mb-6 pt-1">
    <div class="flex items-center gap-3.5">
        <a asp-action="Index"
           class="inline-flex items-center justify-center w-9 h-9 rounded-xl border-[1.5px] border-gray-200 bg-white text-gray-500 no-underline hover:border-blue-500 hover:text-blue-600 hover:bg-blue-50 transition-all">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 12H5M12 5l-7 7 7 7" /></svg>
        </a>
        <div>
            <h1 class="text-2xl font-semibold tracking-tight m-0">Patient Details</h1>
            <p class="text-sm text-gray-500 mt-0.5">Full record overview</p>
        </div>
    </div>
    <div class="hidden md:flex items-center gap-2">
        <a asp-action="Edit" asp-route-id="@Model.PatientId"
           class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl border-[1.5px] border-gray-200 bg-white text-sm font-medium text-gray-500 no-underline hover:text-gray-800 hover:border-gray-400 transition-all">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" /><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" /></svg>
            Edit
        </a>
        <a asp-action="Index"
           class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-blue-600 text-white text-sm font-medium no-underline hover:bg-blue-700 transition-colors shadow-sm">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 12H5M12 5l-7 7 7 7" /></svg>
            Back to List
        </a>
    </div>
</div>

<!-- Profile Card -->
<div class="bg-white border border-gray-200 rounded-2xl shadow-sm p-6 flex items-center gap-5 mb-5">
    <div class="w-16 h-16 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center text-2xl font-semibold flex-shrink-0">
        @Model.FirstName[0]@Model.LastName[0]
    </div>
    <div>
        <h2 class="text-xl font-semibold tracking-tight m-0 mb-1.5">@Model.FullName</h2>
        <div class="flex items-center gap-3 flex-wrap">
            <span class="text-sm text-gray-400 font-mono">@Model.PatientCode</span>
            @if (!string.IsNullOrEmpty(Model.Gender))
            {
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @(Model.Gender == "Female" ? "bg-purple-50 text-purple-700" : "bg-blue-50 text-blue-700")">
                    @Model.Gender
                </span>
            }
            <span class="text-sm text-gray-400">Registered @Model.CreatedAt.ToString("MMMM dd, yyyy")</span>
        </div>
    </div>
</div>

<!-- Info Grid -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-5">

    <div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden">
        <div class="px-5 py-3.5 border-b border-gray-100 bg-gray-50 text-[11px] font-semibold text-gray-400 uppercase tracking-wider">
            Personal Information
        </div>
        <div>
            <div class="flex items-start px-5 py-3.5 border-b border-gray-100">
                <div class="text-sm text-gray-500 w-32 flex-shrink-0 pt-0.5">Date of Birth</div>
                <div class="text-sm font-medium text-gray-900">
                    @if (Model.DateOfBirth.HasValue)
                    {
                        @Model.DateOfBirth.Value.ToString("MMMM dd, yyyy")
                        <span class="text-xs text-gray-400 ml-1.5">(@((DateTime.Now.Year - Model.DateOfBirth.Value.Year)) yrs old)</span>
                    }
                    else
                    {

                        <span class="text-gray-400 italic font-normal">Not provided</span>
                    }
                </div>
            </div>
            <div class="flex items-start px-5 py-3.5">
                <div class="text-sm text-gray-500 w-32 flex-shrink-0 pt-0.5">Gender</div>
                <div class="text-sm font-medium text-gray-900">@(Model.Gender ?? "—")</div>
            </div>
        </div>
    </div>

    <div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden">
        <div class="px-5 py-3.5 border-b border-gray-100 bg-gray-50 text-[11px] font-semibold text-gray-400 uppercase tracking-wider">
            Contact & Insurance
        </div>
        <div>
            <div class="flex items-start px-5 py-3.5 border-b border-gray-100">
                <div class="text-sm text-gray-500 w-32 flex-shrink-0 pt-0.5">Contact No.</div>
                <div class="text-sm font-medium text-gray-900">
                    @if (!string.IsNullOrEmpty(Model.ContactNo))
                    {
                        @Model.ContactNo
                    }
                    else
                    {

                        <span class="text-gray-400 italic font-normal">Not provided</span>
                    }
                </div>
            </div>
            <div class="flex items-start px-5 py-3.5 border-b border-gray-100">
                <div class="text-sm text-gray-500 w-32 flex-shrink-0 pt-0.5">PhilHealth No.</div>
                <div class="text-sm font-medium text-gray-900 font-mono">
                    @if (!string.IsNullOrEmpty(Model.PhilhealthNo))
                    {
                        @Model.PhilhealthNo
                    }
                    else
                    {

                        <span class="text-gray-400 italic font-normal font-sans">Not provided</span>
                    }
                </div>
            </div>
            <div class="flex items-start px-5 py-3.5">
                <div class="text-sm text-gray-500 w-32 flex-shrink-0 pt-0.5">Address</div>
                <div class="text-sm font-medium text-gray-900">
                    @if (!string.IsNullOrEmpty(Model.Address))
                    {
                        @Model.Address
                    }
                    else
                    {

                        <span class="text-gray-400 italic font-normal">Not provided</span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Diagnosis & Nephrologist -->
<div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden">
    <div class="px-5 py-3.5 border-b border-gray-100 bg-gray-50 text-[11px] font-semibold text-gray-400 uppercase tracking-wider">
        Diagnosis / Medical Notes
    </div>
    <div class="px-5 py-4 text-sm leading-relaxed text-gray-900 border-b border-gray-100">
        @if (!string.IsNullOrEmpty(Model.Diagnosis))
        {
            @Model.Diagnosis
        }
        else
        {
            <span class="text-gray-400 italic">No diagnosis recorded.</span>
        }
    </div>
    <div class="flex items-start px-5 py-3.5">
        <div class="text-sm text-gray-500 w-32 flex-shrink-0 pt-0.5">Nephrologist</div>
        <div class="text-sm font-medium text-gray-900">
            @if (!string.IsNullOrEmpty(Model.Nephrologist))
            {
                @Model.Nephrologist
            }
            else
            {
                <span class="text-gray-400 italic font-normal">Not assigned</span>
            }
        </div>
    </div>
</div>

<!-- Hepa Test Summary -->
<div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden mt-5">
    <div class="px-5 py-3.5 border-b border-gray-100 bg-gray-50 flex items-center justify-between">
        <span class="text-[11px] font-semibold text-gray-400 uppercase tracking-wider">Hepatitis Screening</span>
        <a asp-controller="HepaTest" asp-action="Manage" asp-route-patientId="@Model.PatientId"
           class="inline-flex items-center gap-1.5 text-xs font-medium text-blue-600 no-underline hover:underline">
            <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
            </svg>
            @(Model.HepaTest != null ? "Update Tests" : "Add Tests")
        </a>
    </div>

    @if (Model.HepaTest == null)
    {
        <div class="px-5 py-8 text-center">
            <div class="text-3xl mb-2 opacity-30">🧪</div>
            <div class="text-sm font-medium text-gray-500 mb-1">No hepatitis screening on record</div>
            <div class="text-xs text-gray-400">Add the patient's test results using the button above.</div>
        </div>
    }
    else
    {
        var h = Model.HepaTest;

        // Helper: badge color per result
        string BadgeClass(bool tested, MedlinkDialysisCenter.Models.HepaResult? result)
        {
            if (!tested) return "bg-gray-100 text-gray-400";
            return result switch
            {
                MedlinkDialysisCenter.Models.HepaResult.Positive => "bg-red-50 text-red-600 border border-red-200",
                MedlinkDialysisCenter.Models.HepaResult.Negative => "bg-green-50 text-green-600 border border-green-200",
                _ => "bg-gray-100 text-gray-400"
            };
        }

        string BadgeLabel(bool tested, MedlinkDialysisCenter.Models.HepaResult? result)
        {
            if (!tested) return "Not Tested";
            return result switch
            {
                MedlinkDialysisCenter.Models.HepaResult.Positive => "Positive",
                MedlinkDialysisCenter.Models.HepaResult.Negative => "Negative",
                _ => "—"
            };
        }

        <div class="grid grid-cols-3 divide-x divide-gray-100">
            <!-- Hepa B -->
            <div class="px-5 py-4 text-center">
                <div class="text-xs text-gray-400 font-medium mb-2">Hepa B</div>
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold @BadgeClass(h.HepaBTested, h.HepaBResult)">
                    @BadgeLabel(h.HepaBTested, h.HepaBResult)
                </span>
            </div>
            <!-- Anti HBS -->
            <div class="px-5 py-4 text-center">
                <div class="text-xs text-gray-400 font-medium mb-2">Anti HBS</div>
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold @BadgeClass(h.AntiHBSTested, h.AntiHBSResult)">
                    @BadgeLabel(h.AntiHBSTested, h.AntiHBSResult)
                </span>
            </div>
            <!-- Hepa C -->
            <div class="px-5 py-4 text-center">
                <div class="text-xs text-gray-400 font-medium mb-2">Hepa C</div>
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold @BadgeClass(h.HepaCTested, h.HepaCResult)">
                    @BadgeLabel(h.HepaCTested, h.HepaCResult)
                </span>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(h.Remarks))
        {
            <div class="border-t border-gray-100 px-5 py-3 flex items-center gap-5 text-xs text-gray-400">
                @if (!string.IsNullOrEmpty(h.Remarks))
                {
                    <span>Remarks: <span class="text-gray-600">@h.Remarks</span></span>
                }
            </div>
        }
    }
</div>

<!-- Vaccinations -->
<div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden mt-5">
    <div class="px-5 py-3.5 border-b border-gray-100 bg-gray-50 flex items-center justify-between">
        <span class="text-[11px] font-semibold text-gray-400 uppercase tracking-wider">Vaccinations</span>
        <a asp-controller="Vaccine" asp-action="Manage" asp-route-patientId="@Model.PatientId"
           class="inline-flex items-center gap-1.5 text-xs font-medium text-blue-600 no-underline hover:underline">
            <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
            </svg>
            @(Model.Vaccines.Any() ? "Update Vaccines" : "Add Vaccines")
        </a>
    </div>

    @if (!Model.Vaccines.Any())
    {
        <div class="px-5 py-8 text-center">
            <div class="text-3xl mb-2 opacity-30">💉</div>
            <div class="text-sm font-medium text-gray-500 mb-1">No vaccinations on record</div>
            <div class="text-xs text-gray-400">Add vaccine records using the button above.</div>
        </div>
    }
    else
    {
        <div class="divide-y divide-gray-100">
            @foreach (var v in Model.Vaccines.OrderBy(v => v.DateGiven))
            {
                var doseLabel = v.Dose switch
                {
                    MedlinkDialysisCenter.Models.VaccineDose.First   => "1st Dose",
                    MedlinkDialysisCenter.Models.VaccineDose.Second  => "2nd Dose",
                    MedlinkDialysisCenter.Models.VaccineDose.Booster => "Booster",
                    _ => "—"
                };

                var doseColor = v.Dose switch
                {
                    MedlinkDialysisCenter.Models.VaccineDose.First   => "bg-blue-50 text-blue-600 border border-blue-200",
                    MedlinkDialysisCenter.Models.VaccineDose.Second  => "bg-purple-50 text-purple-600 border border-purple-200",
                    MedlinkDialysisCenter.Models.VaccineDose.Booster => "bg-green-50 text-green-600 border border-green-200",
                    _ => "bg-gray-100 text-gray-400"
                };

                <div class="flex items-center gap-4 px-5 py-3.5">
                    <!-- Vaccine icon -->
                    <div class="w-8 h-8 rounded-lg bg-blue-50 text-blue-500 flex items-center justify-center flex-shrink-0">
                        <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path d="M18 2l4 4-4 4" />
                            <path d="M14.5 7.5L22 6" />
                            <path d="M10 7L4 13l7 7 6-6" />
                            <path d="M2 22l4-4" />
                            <path d="M7 17l-3 3" />
                        </svg>
                    </div>

                    <!-- Vaccine name -->
                    <div class="flex-1">
                        <div class="text-sm font-medium text-gray-900">@v.VaccineName</div>
                        <div class="text-xs text-gray-400 mt-0.5">Given on @v.DateGiven.ToString("MMMM dd, yyyy")</div>
                    </div>

                    <!-- Dose badge -->
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold @doseColor">
                        @doseLabel
                    </span>
                </div>
            }
        </div>

        <!-- Summary count -->
        <div class="border-t border-gray-100 px-5 py-3 text-xs text-gray-400">
            @Model.Vaccines.Count() vaccine record@(Model.Vaccines.Count() > 1 ? "s" : "") on file
        </div>
    }
</div>