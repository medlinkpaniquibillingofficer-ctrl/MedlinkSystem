@model MedlinkDialysisCenter.Models.PHRequirement

@{
    ViewData["Title"] = "Delete PhilHealth Record";
}

<!-- Header -->
<div class="flex items-center gap-3.5 mb-6">
    <a asp-action="Index"
       class="inline-flex items-center justify-center w-9 h-9 rounded-xl border-[1.5px] border-gray-200 bg-white text-gray-500 no-underline hover:border-blue-500 hover:text-blue-600 hover:bg-blue-50 transition-all">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 12H5M12 5l-7 7 7 7" /></svg>
    </a>
    <div>
        <h1 class="text-2xl font-semibold tracking-tight m-0">Delete PhilHealth Record</h1>
        <p class="text-sm text-gray-500 mt-0.5">This action cannot be undone.</p>
    </div>
</div>

<!-- Warning Card -->
<div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden">

    <!-- Red warning banner -->
    <div class="flex items-center gap-3 px-7 py-4 bg-red-50 border-b border-red-100">
        <div class="flex items-center justify-center w-9 h-9 rounded-full bg-red-100 flex-shrink-0">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="text-red-600">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" />
            </svg>
        </div>
        <div>
            <div class="text-sm font-semibold text-red-700">You are about to permanently delete this record.</div>
            <div class="text-xs text-red-500 mt-0.5">All PhilHealth requirement data for this patient entry will be removed from the database.</div>
        </div>
    </div>

    <!-- Record Details -->
    <div class="px-7 py-6 border-b border-gray-100">
        <div class="text-[11px] font-semibold text-gray-400 uppercase tracking-wider mb-5">Record Details</div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

            <div class="flex flex-col gap-1">
                <span class="text-xs text-gray-400 font-medium">Patient Name</span>
                <span class="text-sm font-semibold text-gray-800">
                    @(Model.Patient != null
                        ? (string.IsNullOrWhiteSpace(Model.Patient.MiddleName)
                            ? $"{Model.Patient.LastName}, {Model.Patient.FirstName}"
                            : $"{Model.Patient.LastName}, {Model.Patient.FirstName} {Model.Patient.MiddleName}")
                        : "—")
                </span>
            </div>

            <div class="flex flex-col gap-1">
                <span class="text-xs text-gray-400 font-medium">Member Category</span>
                <span class="text-sm font-semibold text-gray-800">@(Model.MemberCategory ?? "—")</span>
            </div>

            <div class="flex flex-col gap-1">
                <span class="text-xs text-gray-400 font-medium">Date Created</span>
                <span class="text-sm text-gray-700">@Model.CreatedAt.ToString("MMMM dd, yyyy")</span>
            </div>

            <div class="flex flex-col gap-1">
                <span class="text-xs text-gray-400 font-medium">Status</span>
                @if (Model.IsComplete)
                {
                    <span class="inline-flex items-center gap-1.5 w-fit px-2.5 py-1 rounded-full bg-green-100 text-green-700 text-xs font-semibold">
                        <svg width="10" height="10" fill="currentColor" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        Complete
                    </span>
                }
                else
                {
                    <span class="inline-flex items-center gap-1.5 w-fit px-2.5 py-1 rounded-full bg-yellow-100 text-yellow-700 text-xs font-semibold">
                        <svg width="10" height="10" fill="currentColor" viewBox="0 0 24 24"><path d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" /></svg>
                        Incomplete
                    </span>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Remarks))
            {
                <div class="flex flex-col gap-1 md:col-span-2">
                    <span class="text-xs text-gray-400 font-medium">Remarks</span>
                    <span class="text-sm text-gray-700">@Model.Remarks</span>
                </div>
            }
        </div>
    </div>

    <!-- Footer Buttons -->
    <div class="px-7 py-4 bg-gray-50 border-t border-gray-100 flex items-center justify-end gap-2.5">
        <a asp-action="Index"
           class="inline-flex items-center px-4 py-2.5 rounded-xl border-[1.5px] border-gray-200 bg-white text-sm font-medium text-gray-500 no-underline hover:text-gray-800 hover:border-gray-400 transition-all">
            Cancel
        </a>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <button type="submit"
                    class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-xl bg-red-600 text-white text-sm font-medium hover:bg-red-700 transition-colors shadow-sm border-none cursor-pointer">
                <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <polyline points="3 6 5 6 21 6" />
                    <path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6" />
                    <path d="M10 11v6M14 11v6" />
                    <path d="M9 6V4h6v2" />
                </svg>
                Yes, Delete Record
            </button>
        </form>
    </div>
</div>