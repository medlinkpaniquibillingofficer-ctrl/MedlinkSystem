@model IEnumerable<MedlinkDialysisCenter.Models.PHRequirement>

@{
    ViewData["Title"] = "PhilHealth Tracker";
}

<!-- Header -->
<div class="flex items-center justify-between mb-6 pt-1 flex-wrap gap-4">
    <div>
        <h1 class="text-2xl font-semibold tracking-tight m-0">PhilHealth Tracker</h1>
        <p class="text-sm text-gray-500 mt-1">Monitor patient requirements for PhilHealth coverage</p>
    </div>
    <div class="flex items-center gap-2">
        <!-- Export Button -->
        <a asp-action="ExportPhilHealthToExcel"
           class="inline-flex items-center gap-1.5 bg-white text-gray-700 text-sm font-medium px-4 py-2.5 rounded-xl no-underline border-[1.5px] border-gray-200 hover:border-green-500 hover:text-green-600 hover:bg-green-50 transition-all shadow-sm">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                <polyline points="7 10 12 15 17 10" />
                <line x1="12" y1="15" x2="12" y2="3" />
            </svg>
            Export to Excel
        </a>
        <!-- Add Record Button -->
        <a asp-action="Create"
           class="inline-flex items-center gap-1.5 bg-blue-600 text-white text-sm font-medium px-4 py-2.5 rounded-xl no-underline hover:bg-blue-700 transition-colors shadow-sm">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /></svg>
            Add Record
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div id="toast-success"
         class="flex items-center gap-3 mb-4 px-4 py-3 rounded-xl bg-green-50 border border-green-200 text-green-700 text-sm font-medium shadow-sm">
        <svg class="w-5 h-5 text-green-500 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <span>@TempData["Success"]</span>
        <button onclick="document.getElementById('toast-success').remove()"
                class="ml-auto text-green-400 hover:text-green-600 transition-colors bg-transparent border-none cursor-pointer p-0">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M6 18L18 6M6 6l12 12"/>
            </svg>
        </button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div id="toast-error"
         class="flex items-center gap-3 mb-4 px-4 py-3 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm font-medium shadow-sm">
        <svg class="w-5 h-5 text-red-500 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <span>@TempData["Error"]</span>
        <button onclick="document.getElementById('toast-error').remove()"
                class="ml-auto text-red-400 hover:text-red-600 transition-colors bg-transparent border-none cursor-pointer p-0">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M6 18L18 6M6 6l12 12"/>
            </svg>
        </button>
    </div>
}

<!-- Stat Cards -->
<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
    <div class="bg-white border border-gray-200 rounded-xl px-5 py-4 shadow-sm">
        <div class="text-xs text-gray-500 font-medium mb-1">Total Records</div>
        <div class="text-2xl font-semibold text-blue-600">@Model.Count()</div>
    </div>
    <div class="bg-white border border-gray-200 rounded-xl px-5 py-4 shadow-sm">
        <div class="text-xs text-gray-500 font-medium mb-1">Complete</div>
        <div class="text-2xl font-semibold text-green-600">@Model.Count(r => r.IsComplete)</div>
    </div>
    <div class="bg-white border border-gray-200 rounded-xl px-5 py-4 shadow-sm">
        <div class="text-xs text-gray-500 font-medium mb-1">Incomplete</div>
        <div class="text-2xl font-semibold text-red-500">@Model.Count(r => !r.IsComplete)</div>
    </div>
    <div class="bg-white border border-gray-200 rounded-xl px-5 py-4 shadow-sm">
        <div class="text-xs text-gray-500 font-medium mb-1">Completion Rate</div>
        <div class="text-2xl font-semibold text-purple-600">
            @(Model.Any() ? $"{(int)((double)Model.Count(r => r.IsComplete) / Model.Count() * 100)}%" : "0%")
        </div>
    </div>
</div>

<!-- Filter + Search -->
<div class="flex flex-wrap gap-3 mb-4">
    <div class="relative flex-1 min-w-[200px]">
        <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.35-4.35" /></svg>
        <input type="text" id="searchInput" placeholder="Search patient name..."
               class="w-full pl-10 pr-4 py-2.5 border-[1.5px] border-gray-200 rounded-xl text-sm focus:outline-none focus:border-blue-500 bg-white transition-colors" />
    </div>
    <select id="categoryFilter" class="px-4 py-2.5 border-[1.5px] border-gray-200 rounded-xl text-sm bg-white focus:outline-none focus:border-blue-500 cursor-pointer">
        <option value="">All Categories</option>
        <option value="Senior Citizen">Senior Citizen</option>
        <option value="Indigent">Indigent</option>
        <option value="Self-Employed">Self-Employed</option>
        <option value="Employed Government">Employed Government</option>
    </select>
    <select id="statusFilter" class="px-4 py-2.5 border-[1.5px] border-gray-200 rounded-xl text-sm bg-white focus:outline-none focus:border-blue-500 cursor-pointer">
        <option value="">All Status</option>
        <option value="complete">Complete</option>
        <option value="incomplete">Incomplete</option>
    </select>
</div>

<!-- Table -->
<div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden">
    @if (!Model.Any())
    {
        <div class="text-center py-16">
            <div class="text-4xl mb-3 opacity-40">📋</div>
            <div class="text-base font-medium text-gray-700 mb-1">No records yet</div>
            <div class="text-sm text-gray-400">Add your first PhilHealth requirement record.</div>
        </div>
    }
    else
    {
        <!-- Mirror scrollbar: lalabas lang kapag may overflow (split/minimized) -->
        <div id="topScrollbar" class="overflow-x-auto border-b border-gray-100" style="height: 0px; transition: height 0.15s ease;">
            <div id="topScrollbarSpacer" style="height: 1px;"></div>
        </div>

        <div id="tableScroll" class="overflow-x-auto">
            <table class="w-full text-sm" id="trackerTable">
                <thead>
                    <tr class="border-b border-gray-100 bg-gray-50">
                        <th class="text-left text-[11px] font-semibold uppercase tracking-wide text-gray-500 px-3 py-3 whitespace-nowrap sticky left-0 bg-gray-50 z-20 w-[90px] min-w-[90px]">Code</th>
                        <th class="text-left text-[11px] font-semibold uppercase tracking-wide text-gray-500 px-3 py-3 whitespace-nowrap sticky left-[90px] bg-gray-50 z-20 w-[150px] min-w-[150px] shadow-[4px_0_6px_-2px_rgba(0,0,0,0.08)]">Patient Name</th>
                        <th class="text-left text-[11px] font-semibold uppercase tracking-wide text-gray-500 px-3 py-3 whitespace-nowrap w-[120px] min-w-[120px]">Category</th>
                        <th class="text-center text-[11px] font-semibold uppercase tracking-wide text-gray-500 px-2 py-3 whitespace-nowrap w-[55px] min-w-[55px]">CSF</th>
                        <th class="text-center text-[11px] font-semibold uppercase tracking-wide text-gray-500 px-2 py-3 whitespace-nowrap w-[55px] min-w-[55px]">CF2</th>
                        <th class="text-center text-[11px] font-semibold uppercase tracking-wide text-gray-500 px-2 py-3 whitespace-nowrap w-[55px] min-w-[55px]">MDR</th>
                        <th class="text-center text-[11px] font-semibold uppercase tracking-wide text-gray-500 px-2 py-3 whitespace-nowrap w-[65px] min-w-[65px]" title="PhilHealth ID">PH ID</th>
                        <th class="text-center text-[11px] font-semibold uppercase tracking-wide text-gray-500 px-2 py-3 whitespace-nowrap w-[65px] min-w-[65px]" title="Receipt (6 Months)">RCPT.</th>
                        <th class="text-center text-[11px] font-semibold uppercase tracking-wide text-gray-500 px-2 py-3 whitespace-nowrap w-[65px] min-w-[65px]" title="Certificate of Contribution">CERT.</th>
                        <th class="text-center text-[11px] font-semibold uppercase tracking-wide text-gray-500 px-2 py-3 whitespace-nowrap w-[60px] min-w-[60px]" title="Senior Citizen ID">SC ID</th>
                        <th class="text-center text-[11px] font-semibold uppercase tracking-wide text-gray-500 px-2 py-3 whitespace-nowrap w-[80px] min-w-[80px]" title="CSF with Employer Signature">CSF+EMP</th>
                        <th class="text-center text-[11px] font-semibold uppercase tracking-wide text-gray-500 px-2 py-3 whitespace-nowrap w-[60px] min-w-[60px]" title="PDD Registration">PDD</th>
                        <th class="text-center text-[11px] font-semibold uppercase tracking-wide text-gray-500 px-2 py-3 whitespace-nowrap w-[75px] min-w-[75px]" title="PhilHealth Consumption">PH CONS.</th>
                        <th class="text-center text-[11px] font-semibold uppercase tracking-wide text-gray-500 px-3 py-3 whitespace-nowrap w-[105px] min-w-[105px]">Status</th>
                        <th class="px-3 py-3 w-[70px] min-w-[70px]"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr class="group border-b border-gray-100 last:border-0 hover:bg-slate-50 transition-colors"
                            data-category="@r.MemberCategory"
                            data-status="@(r.IsComplete ? "complete" : "incomplete")">

                            <td class="px-3 py-3 font-medium text-gray-900 whitespace-nowrap sticky left-0 z-10 bg-white group-hover:bg-slate-50 w-[90px] min-w-[90px]">
                                @r.Patient.PatientCode
                            </td>

                            <!-- Patient Name -->
                            <td class="px-3 py-3 font-medium text-gray-900 whitespace-nowrap sticky left-[90px] z-10 bg-white group-hover:bg-slate-50 w-[150px] min-w-[150px] shadow-[4px_0_6px_-2px_rgba(0,0,0,0.08)]">
                                @r.Patient.FullName
                            </td>

                            <!-- Category -->
                            <td class="px-3 py-3 whitespace-nowrap w-[120px] min-w-[120px]">
                                @{
                                    var catClass = r.MemberCategory switch
                                    {
                                        "Senior Citizen" => "bg-green-50 text-green-700",
                                        "Indigent" => "bg-orange-50 text-orange-700",
                                        "Self-Employed" => "bg-blue-50 text-blue-700",
                                        "Employed Government" => "bg-purple-50 text-purple-700",
                                        _ => "bg-gray-100 text-gray-600"
                                    };
                                }
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @catClass">
                                    @(r.MemberCategory ?? "—")
                                </span>
                            </td>

                            <!-- Requirement checkmarks -->
                            <td class="px-2 py-3 text-center w-[55px] min-w-[55px]">@Html.Raw(r.HasCSF ? "<span class='text-green-500 text-base font-bold'>✓</span>" : "<span class='text-red-400 text-base'>✗</span>")</td>
                            <td class="px-2 py-3 text-center w-[55px] min-w-[55px]">@Html.Raw(r.HasCF2 ? "<span class='text-green-500 text-base font-bold'>✓</span>" : "<span class='text-red-400 text-base'>✗</span>")</td>
                            <td class="px-2 py-3 text-center w-[55px] min-w-[55px]">@Html.Raw(r.HasMDR ? "<span class='text-green-500 text-base font-bold'>✓</span>" : "<span class='text-red-400 text-base'>✗</span>")</td>
                            <td class="px-2 py-3 text-center w-[65px] min-w-[65px]">@Html.Raw(r.HasPhilhealthId ? "<span class='text-green-500 text-base font-bold'>✓</span>" : "<span class='text-red-400 text-base'>✗</span>")</td>
                            <td class="px-2 py-3 text-center w-[65px] min-w-[65px]">@Html.Raw(r.HasReceipt6Mos ? "<span class='text-green-500 text-base font-bold'>✓</span>" : "<span class='text-gray-300 text-base'>—</span>")</td>
                            <td class="px-2 py-3 text-center w-[65px] min-w-[65px]">@Html.Raw(r.HasCertMonthlyContrib ? "<span class='text-green-500 text-base font-bold'>✓</span>" : "<span class='text-gray-300 text-base'>—</span>")</td>
                            <td class="px-2 py-3 text-center w-[60px] min-w-[60px]">@Html.Raw(r.HasSCId ? "<span class='text-green-500 text-base font-bold'>✓</span>" : "<span class='text-gray-300 text-base'>—</span>")</td>
                            <td class="px-2 py-3 text-center w-[80px] min-w-[80px]">@Html.Raw(r.HasCSFEmployerSig ? "<span class='text-green-500 text-base font-bold'>✓</span>" : "<span class='text-gray-300 text-base'>—</span>")</td>
                            <td class="px-2 py-3 text-center w-[60px] min-w-[60px]">@Html.Raw(r.HasPDDRegistration ? "<span class='text-green-500 text-base font-bold'>✓</span>" : "<span class='text-red-400 text-base'>✗</span>")</td>
                            <td class="px-2 py-3 text-center w-[75px] min-w-[75px]">@Html.Raw(r.HasPhilhealthConsumption ? "<span class='text-green-500 text-base font-bold'>✓</span>" : "<span class='text-gray-300 text-base'>—</span>")</td>

                            <!-- Status -->
                            <td class="px-3 py-3 text-center w-[105px] min-w-[105px]">
                                @if (r.IsComplete)
                                {
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-green-100 text-green-700">COMPLETE</span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-red-100 text-red-600">INCOMPLETE</span>
                                }
                            </td>

                            <!-- Actions -->
                            <td class="px-3 py-3 w-[70px] min-w-[70px]">
                                <div class="flex items-center gap-1.5">
                                    <a asp-action="Edit" asp-route-id="@r.Id"
                                       class="inline-flex items-center justify-center w-8 h-8 rounded-lg border-[1.5px] border-gray-200 bg-white text-gray-500 no-underline hover:border-blue-500 hover:text-blue-600 hover:bg-blue-50 transition-all">
                                        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" /><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" /></svg>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@r.Id"
                                       class="inline-flex items-center justify-center w-8 h-8 rounded-lg border-[1.5px] border-gray-200 bg-white text-gray-500 no-underline hover:border-red-500 hover:text-red-600 hover:bg-red-50 transition-all">
                                        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6" /><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" /><path d="M10 11v6M14 11v6" /></svg>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<script>
    function filterTable() {
        const q = document.getElementById('searchInput').value.toLowerCase();
        const cat = document.getElementById('categoryFilter').value;
        const status = document.getElementById('statusFilter').value;

        document.querySelectorAll('#trackerTable tbody tr').forEach(row => {
            const name = row.cells[1].textContent.toLowerCase();
            const rowCat = row.dataset.category ?? '';
            const rowStatus = row.dataset.status ?? '';

            const matchName = name.includes(q);
            const matchCat = !cat || rowCat === cat;
            const matchStatus = !status || rowStatus === status;

            row.style.display = (matchName && matchCat && matchStatus) ? '' : 'none';
        });
    }

    document.getElementById('searchInput').addEventListener('input', filterTable);
    document.getElementById('categoryFilter').addEventListener('change', filterTable);
    document.getElementById('statusFilter').addEventListener('change', filterTable);

    // Mirror scrollbar logic: lalabas lang kapag may overflow (split/minimized)
    const topScrollbar = document.getElementById('topScrollbar');
    const topScrollbarSpacer = document.getElementById('topScrollbarSpacer');
    const tableScroll = document.getElementById('tableScroll');
    const trackerTable = document.getElementById('trackerTable');

    function checkTrackerOverflow() {
        if (!trackerTable || !tableScroll || !topScrollbar) return;

        const hasOverflow = trackerTable.scrollWidth > tableScroll.clientWidth;

        topScrollbarSpacer.style.width = trackerTable.scrollWidth + 'px';

        topScrollbar.style.height = hasOverflow ? '16px' : '0px';
    }

    if (topScrollbar && tableScroll && trackerTable) {
        checkTrackerOverflow();

        window.addEventListener('resize', checkTrackerOverflow);

        if (window.ResizeObserver) {
            const ro = new ResizeObserver(checkTrackerOverflow);
            ro.observe(tableScroll);
        }

        topScrollbar.addEventListener('scroll', () => {
            tableScroll.scrollLeft = topScrollbar.scrollLeft;
        });
        tableScroll.addEventListener('scroll', () => {
            topScrollbar.scrollLeft = tableScroll.scrollLeft;
        });
    }
</script>
