@{
    ViewData["Title"] = "Login";
    Layout = null; // No navbar/layout for login page
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login – Medlink Dialysis Center</title>
    <style>
            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                font-family: 'Segoe UI', sans-serif;
                background: #f0f4f8;
                display: flex;
                justify-content: center;
                align-items: center;
                min-height: 100vh;
            }

            .login-card {
                background: white;
                padding: 2.5rem;
                border-radius: 12px;
                box-shadow: 0 4px 20px rgba(0,0,0,0.1);
                width: 100%;
                max-width: 400px;
            }

                .login-card h2 {
                    text-align: center;
                    color: #1a56db;
                    margin-bottom: 0.25rem;
                    font-size: 1.5rem;
                }

                .login-card p.subtitle {
                    text-align: center;
                    color: #6b7280;
                    font-size: 0.875rem;
                    margin-bottom: 1.75rem;
                }

            .form-group {
                margin-bottom: 1.25rem;
            }

            label {
                display: block;
                font-size: 0.875rem;
                font-weight: 600;
                color: #374151;
                margin-bottom: 0.4rem;
            }

            input {
                width: 100%;
                padding: 0.65rem 1rem;
                border: 1px solid #d1d5db;
                border-radius: 8px;
                font-size: 0.95rem;
                transition: border 0.2s;
            }

                input:focus {
                    outline: none;
                    border-color: #1a56db;
                }

            .error-msg {
                background: #fee2e2;
                color: #b91c1c;
                padding: 0.65rem 1rem;
                border-radius: 8px;
                font-size: 0.875rem;
                margin-bottom: 1rem;
            }

            button[type="submit"] {
                width: 100%;
                padding: 0.75rem;
                background: #1a56db;
                color: white;
                border: none;
                border-radius: 8px;
                font-size: 1rem;
                font-weight: 600;
                cursor: pointer;
                transition: background 0.2s;
            }

                button[type="submit"]:hover {
                    background: #1e429f;
                }
    </style>
</head>
<body>
    <div class="login-card">
        <h2>Medlink Dialysis Center</h2>
        <p class="subtitle">Sign in to your account</p>

        @if (ViewBag.Error != null)
        {
            <div class="error-msg">@ViewBag.Error</div>
        }

        <form method="post" asp-action="Login" asp-controller="Account">
            <div class="form-group">
                <label>Email</label>
                <input type="email" name="email" placeholder="Enter your email" required />
            </div>
            <div class="form-group">
                <label>Password</label>
                <input type="password" name="password" placeholder="Enter your password" required />
            </div>
            <button type="submit">Sign In</button>
        </form>
    </div>
</body>
</html>