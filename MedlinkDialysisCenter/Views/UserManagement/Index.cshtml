@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityUser>
@{
    ViewData["Title"] = "User Management";
}

<h2>User Management</h2>

@if (TempData["Success"] != null)
{
    <div style="background:#d1fae5; color:#065f46; padding:0.75rem;
        border-radius:8px; margin-bottom:1rem;">
        @TempData["Success"]
    </div>
}

<a href="/UserManagement/Create"
   style="background:#1a56db; color:white; padding:0.5rem 1rem;
    border-radius:8px; text-decoration:none; display:inline-block;
    margin-bottom:1rem;">
    + Add New User
</a>

<table style="width:100%; border-collapse:collapse;">
    <thead style="background:#f3f4f6;">
        <tr>
            <th style="padding:0.75rem; text-align:left; border:1px solid #e5e7eb;">Email</th>
            <th style="padding:0.75rem; text-align:left; border:1px solid #e5e7eb;">Role</th>
            <th style="padding:0.75rem; text-align:left; border:1px solid #e5e7eb;">Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td style="padding:0.75rem; border:1px solid #e5e7eb;">@user.Email</td>
                <td style="padding:0.75rem; border:1px solid #e5e7eb;">
                    @(((Dictionary<string, string>)ViewBag.UserRoles)[user.Id])
                </td>
                <td style="padding:0.75rem; border:1px solid #e5e7eb;">
                    <form method="post" asp-action="Delete" asp-route-id="@user.Id"
                          id="delete-form-@user.Id">
                        <button type="button"
                                onclick="showDeleteModal('delete-form-@user.Id', '@user.Email')"
                                style="background:#ef4444; color:white; border:none;
                            padding:0.4rem 0.75rem; border-radius:6px; cursor:pointer;">
                            Delete
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Confirmation modal -->
<div id="deleteModalOverlay" style="display:none; position:fixed; top:0; left:0;
    width:100%; height:100%; background:rgba(0,0,0,0.5); align-items:center;
    justify-content:center; z-index:1000;" onclick="if(event.target===this) closeDeleteModal()">
    <div style="background:white; border-radius:10px; padding:1.5rem; width:90%;
        max-width:400px; box-shadow:0 10px 25px rgba(0,0,0,0.2);">
        <h3 style="margin-top:0;">Delete user?</h3>
        <p style="color:#374151;">
            Are you sure you want to delete <strong id="deleteModalEmail"></strong>?
            This action cannot be undone.
        </p>
        <div style="display:flex; justify-content:flex-end; gap:0.5rem; margin-top:1rem;">
            <button type="button" onclick="closeDeleteModal()"
                    style="background:#e5e7eb; color:#111827; border:none;
                padding:0.5rem 1rem; border-radius:6px; cursor:pointer;">
                Cancel
            </button>
            <button type="button" onclick="confirmDelete()"
                    style="background:#ef4444; color:white; border:none;
                padding:0.5rem 1rem; border-radius:6px; cursor:pointer;">
                Yes, Delete
            </button>
        </div>
    </div>
</div>

<script>
    let formIdToDelete = null;

    function showDeleteModal(formId, email) {
        formIdToDelete = formId;
        document.getElementById('deleteModalEmail').textContent = email;
        document.getElementById('deleteModalOverlay').style.display = 'flex';
    }

    function closeDeleteModal() {
        formIdToDelete = null;
        document.getElementById('deleteModalOverlay').style.display = 'none';
    }

    function confirmDelete() {
        if (formIdToDelete) {
            document.getElementById(formIdToDelete).submit();
        }
    }
</script>