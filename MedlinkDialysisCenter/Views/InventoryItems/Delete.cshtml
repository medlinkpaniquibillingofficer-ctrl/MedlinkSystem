@model MedlinkDialysisCenter.Models.InventoryItemModel

@{
    ViewData["Title"] = "Remove Item";
}

<!-- Header -->
<div class="flex items-center gap-3.5 mb-7">
    <a asp-action="Index"
       class="inline-flex items-center justify-center w-9 h-9 rounded-xl border-[1.5px] border-gray-200 bg-white text-gray-500 no-underline hover:border-blue-500 hover:text-blue-600 hover:bg-blue-50 transition-all">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 12H5M12 5l-7 7 7 7" /></svg>
    </a>
    <div>
        <h1 class="text-2xl font-semibold tracking-tight m-0">Remove item</h1>
        <p class="text-sm text-gray-500 mt-0.5">This item will be hidden from the active list</p>
    </div>
</div>

<div class="max-w-lg">
    <div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden">
        <div class="bg-amber-50 border-b border-amber-200 px-6 py-4 flex items-start gap-3">
            <div class="w-9 h-9 rounded-full bg-amber-100 flex items-center justify-center text-amber-600 flex-shrink-0">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /><line x1="12" y1="9" x2="12" y2="13" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg>
            </div>
            <div>
                <div class="text-sm font-semibold text-amber-700 mb-1">Remove this item?</div>
                <div class="text-sm text-amber-600 leading-relaxed">@Model.Name will no longer appear in the active inventory list. Its transaction history will be kept.</div>
            </div>
        </div>

        <div class="px-6 py-5 border-b border-gray-100">
            <div class="grid grid-cols-2 gap-2.5">
                <div class="text-sm text-gray-500">Unit: <span class="text-gray-800 font-medium">@Model.Unit</span></div>
                <div class="text-sm text-gray-500">Current stock: <span class="text-gray-800 font-medium">@Model.CurrentStock</span></div>
            </div>
        </div>

        <div class="px-6 py-4 bg-gray-50 flex items-center justify-end gap-2.5">
            <a asp-action="Index"
               class="inline-flex items-center px-4 py-2.5 rounded-xl border-[1.5px] border-gray-200 bg-white text-sm font-medium text-gray-500 no-underline hover:text-gray-800 hover:border-gray-400 transition-all">
                Cancel
            </a>
            <form asp-action="Delete" method="post" style="margin:0">
                <input type="hidden" asp-for="Id" />
                <button type="submit"
                        class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-xl bg-amber-600 text-white text-sm font-medium hover:bg-amber-700 transition-colors shadow-sm border-none cursor-pointer">
                    Yes, Remove Item
                </button>
            </form>
        </div>
    </div>
</div>