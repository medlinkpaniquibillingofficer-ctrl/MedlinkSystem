@model MedlinkDialysisCenter.Models.InventoryItemModel
@using MedlinkDialysisCenter.Extensions
@using MedlinkDialysisCenter.Enums

@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "Add Item" : "Edit Item";
}

<!-- Header -->
<div class="flex items-center gap-3.5 mb-7">
    <a asp-action="Index"
       class="inline-flex items-center justify-center w-9 h-9 rounded-xl border-[1.5px] border-gray-200 bg-white text-gray-500 no-underline hover:border-blue-500 hover:text-blue-600 hover:bg-blue-50 transition-all">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 12H5M12 5l-7 7 7 7" /></svg>
    </a>
    <div>
        <h1 class="text-2xl font-semibold tracking-tight m-0">@(isNew ? "Add item" : "Edit item")</h1>
        <p class="text-sm text-gray-500 mt-0.5">@(isNew ? "Register a new material or supply" : "Update item details")</p>
    </div>
</div>

<div class="max-w-lg">
    <form asp-action="@(isNew ? "Create" : "Edit")" method="post" class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden">
        @if (!isNew)
        {
            <input type="hidden" asp-for="Id" />
        }

        <div class="px-6 py-5 space-y-4">

            <!-- Name -->
            <div>
                <label asp-for="Name" class="block text-xs font-medium text-gray-500 mb-1.5">Material name</label>
                <input asp-for="Name"
                       class="w-full px-3.5 py-2.5 rounded-xl border-[1.5px] border-gray-200 text-sm focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition-all"
                       placeholder="e.g. Bloodlines" />
                <span asp-validation-for="Name" class="text-xs text-red-500"></span>
            </div>

            <!-- Category -->
            <div>
                <label asp-for="Category" class="block text-xs font-medium text-gray-500 mb-1.5">Category</label>
                <select asp-for="Category"
                        class="w-full px-3.5 py-2.5 rounded-xl border-[1.5px] border-gray-200 text-sm text-gray-800 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition-all appearance-none bg-white">
                    @foreach (var cat in Enum.GetValues<InventoryCategory>())
                    {
                        <option value="@cat">@cat.GetDisplayName()</option>
                    }
                </select>
                <span asp-validation-for="Category" class="text-xs text-red-500"></span>
            </div>

            <!-- Unit -->
            <div>
                <label asp-for="Unit" class="block text-xs font-medium text-gray-500 mb-1.5">Unit</label>
                <input asp-for="Unit"
                       class="w-full px-3.5 py-2.5 rounded-xl border-[1.5px] border-gray-200 text-sm focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition-all"
                       placeholder="e.g. box, piece, gallon" />
                <span asp-validation-for="Unit" class="text-xs text-red-500"></span>
            </div>

            <!-- Stock -->
            @if (isNew)
            {
                <div>
                    <label asp-for="CurrentStock" class="block text-xs font-medium text-gray-500 mb-1.5">Starting stock</label>
                    <input asp-for="CurrentStock" type="number" min="0"
                           class="w-full px-3.5 py-2.5 rounded-xl border-[1.5px] border-gray-200 text-sm focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition-all" />
                    <p class="text-xs text-gray-400 mt-1">Current count on hand when adding this item to the system.</p>
                </div>
            }
            else
            {
                <div>
                    <label class="block text-xs font-medium text-gray-500 mb-1.5">Current stock</label>
                    <div class="px-3.5 py-2.5 rounded-xl bg-gray-50 border-[1.5px] border-gray-100 text-sm text-gray-500">
                        @Model.CurrentStock @Model.Unit
                    </div>
                    <p class="text-xs text-gray-400 mt-1">Stock levels change through stock in/out entries, not here.</p>
                </div>
            }

            <!-- Reorder level -->
            <div>
                <label asp-for="ReorderLevel" class="block text-xs font-medium text-gray-500 mb-1.5">Reorder level</label>
                <input asp-for="ReorderLevel" type="number" min="0"
                       class="w-full px-3.5 py-2.5 rounded-xl border-[1.5px] border-gray-200 text-sm focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition-all" />
                <p class="text-xs text-gray-400 mt-1">Item is flagged as low stock at or below this quantity.</p>
            </div>

        </div>

        <!-- Footer -->
        <div class="px-6 py-4 bg-gray-50 border-t border-gray-100 flex items-center justify-end gap-2.5">
            <a asp-action="Index"
               class="inline-flex items-center px-4 py-2.5 rounded-xl border-[1.5px] border-gray-200 bg-white text-sm font-medium text-gray-500 no-underline hover:text-gray-800 hover:border-gray-400 transition-all">
                Cancel
            </a>
            <button type="submit"
                    class="inline-flex items-center px-5 py-2.5 rounded-xl bg-blue-600 text-white text-sm font-medium hover:bg-blue-700 transition-colors shadow-sm border-none cursor-pointer">
                @(isNew ? "Add Item" : "Save Changes")
            </button>
        </div>

    </form>
</div>