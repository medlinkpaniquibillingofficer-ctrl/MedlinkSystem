@using MedlinkDialysisCenter.Enums
@using MedlinkDialysisCenter.Extensions
@model List<MedlinkDialysisCenter.Models.InventoryItemModel>

@{
    ViewData["Title"] = "Inventory Items";
    var selected = ViewBag.SelectedCategory as InventoryCategory?;
    var categories = (InventoryCategory[])ViewBag.Categories;
}

<!-- Header -->
<div class="flex items-center justify-between mb-6 pt-1">
    <div>
        <h1 class="text-2xl font-semibold tracking-tight m-0">Inventory Items</h1>
        <p class="text-sm text-gray-500 mt-1">Manage materials and supplies tracked by the center</p>
    </div>
    <div class="flex items-center gap-2">
        <!-- Export respects active tab filter -->
        <a asp-action="ExportToExcel"
           asp-route-category="@selected"
           class="inline-flex items-center gap-1.5 bg-white text-gray-700 text-sm font-medium px-4 py-2.5 rounded-xl no-underline border-[1.5px] border-gray-200 hover:border-green-500 hover:text-green-600 hover:bg-green-50 transition-all shadow-sm">
            <i class="bi bi-file-earmark-excel"></i>
            Export to Excel
        </a>
        <a asp-action="Create"
           class="inline-flex items-center gap-1.5 bg-blue-600 text-white text-sm font-medium px-4 py-2.5 rounded-xl no-underline hover:bg-blue-700 transition-colors shadow-sm">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M12 5v14M5 12h14" />
            </svg>
            Add Item
        </a>
    </div>
</div>

<!-- Category Tabs -->
<div class="flex items-center gap-1 mb-4 flex-wrap">
    <a asp-action="Index"
       class="px-3.5 py-1.5 rounded-lg text-sm font-medium no-underline transition-all
        @(selected == null ? "bg-blue-600 text-white shadow-sm" : "text-gray-500 hover:text-gray-700 hover:bg-gray-100")">
        All
    </a>
    @foreach (var cat in categories)
    {
        <a asp-action="Index" asp-route-category="@cat"
           class="px-3.5 py-1.5 rounded-lg text-sm font-medium no-underline transition-all
            @(selected == cat ? "bg-blue-600 text-white shadow-sm" : "text-gray-500 hover:text-gray-700 hover:bg-gray-100")">
            @cat.GetDisplayName()
        </a>
    }
</div>

<!-- Search Bar -->
<div class="relative mb-4">
    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="text-gray-400">
            <circle cx="11" cy="11" r="8" />
            <path d="m21 21-4.35-4.35" />
        </svg>
    </div>
    <input type="text"
           id="searchInput"
           placeholder="Search items..."
           class="w-full pl-10 pr-4 py-2.5 rounded-xl border-[1.5px] border-gray-200 text-sm focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition-all bg-white" />
</div>

<!-- Table -->
<div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden">
    @if (!Model.Any())
    {
        <div class="px-6 py-14 text-center text-sm text-gray-400">
            No inventory items found@(selected != null ? $" in {selected.Value.GetDisplayName()}" : "").
        </div>
    }
    else
    {
        <table class="w-full text-sm">
            <thead>
                <tr class="bg-gray-50 border-b border-gray-200 text-left text-[10px] font-semibold text-gray-400 uppercase tracking-wider">
                    <th class="px-6 py-3">Material</th>
                    <th class="px-6 py-3">Category</th>
                    <th class="px-6 py-3">Unit</th>
                    <th class="px-6 py-3">Current stock</th>
                    <th class="px-6 py-3">Reorder level</th>
                    <th class="px-6 py-3 text-right">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var isLow = item.CurrentStock <= item.ReorderLevel;
                    <tr class="border-b border-gray-100 last:border-0 hover:bg-gray-50/50 inventory-row"
                        data-search="@($"{item.Name} {item.Category.GetDisplayName()} {item.Unit}")">
                        <td class="px-6 py-4 font-medium text-gray-900">@item.Name</td>
                        <td class="px-6 py-4">
                            <span class="inline-flex items-center px-2.5 py-1 rounded-lg bg-gray-100 text-gray-600 font-medium text-xs">
                                @item.Category.GetDisplayName()
                            </span>
                        </td>
                        <td class="px-6 py-4 text-gray-600">@item.Unit</td>
                        <td class="px-6 py-4">
                            @if (isLow)
                            {
                                <span class="inline-flex items-center px-2.5 py-1 rounded-lg bg-amber-50 text-amber-700 font-medium text-xs">
                                    @item.CurrentStock @item.Unit · Low
                                </span>
                            }
                            else
                            {
                                <span class="text-gray-800">@item.CurrentStock @item.Unit</span>
                            }
                        </td>
                        <td class="px-6 py-4 text-gray-500">@item.ReorderLevel</td>
                        <td class="px-6 py-4 text-right">
                            <div class="inline-flex items-center gap-2">
                                <a asp-controller="StockTransactions" asp-action="Create" asp-route-itemId="@item.Id"
                                   class="inline-flex items-center px-3 py-1.5 rounded-lg border-[1.5px] border-gray-200 bg-white text-xs font-medium text-gray-600 no-underline hover:border-green-500 hover:text-green-600 transition-all">
                                    Log Stock
                                </a>
                                <a asp-controller="StockTransactions" asp-action="History" asp-route-itemId="@item.Id"
                                   class="inline-flex items-center px-3 py-1.5 rounded-lg border-[1.5px] border-gray-200 bg-white text-xs font-medium text-gray-600 no-underline hover:border-gray-400 hover:text-gray-800 transition-all">
                                    History
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id"
                                   class="inline-flex items-center px-3 py-1.5 rounded-lg border-[1.5px] border-gray-200 bg-white text-xs font-medium text-gray-600 no-underline hover:border-blue-500 hover:text-blue-600 transition-all">
                                    Edit
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id"
                                   class="inline-flex items-center px-3 py-1.5 rounded-lg border-[1.5px] border-gray-200 bg-white text-xs font-medium text-gray-600 no-underline hover:border-red-500 hover:text-red-600 transition-all">
                                    Remove
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <div id="noResults"
             class="hidden px-6 py-10 text-center text-sm text-gray-400">
            No matching inventory items found.
        </div>
    }
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const searchInput = document.getElementById("searchInput");
        const rows = document.querySelectorAll(".inventory-row");
        const noResults = document.getElementById("noResults");

        function filterRows() {

            const search = searchInput.value.trim().toLowerCase();
            let visibleCount = 0;

            rows.forEach(row => {

                const text = row.dataset.search.toLowerCase();

                const match = text.includes(search);

                row.style.display = match ? "" : "none";

                if (match) {
                    visibleCount++;
                }
            });

            noResults.classList.toggle("hidden", visibleCount > 0);
        }

        searchInput.addEventListener("input", filterRows);
    });
</script>