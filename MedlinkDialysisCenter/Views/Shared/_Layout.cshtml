<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Medlink Dialysis Center</title>

    <script type="importmap"></script>

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
        theme: {
        extend: {
        fontFamily: {
        sans: ['DM Sans', 'sans-serif']
        },
        colors: {
        sidebar: '#0F1117',
        }
        }
        }
        }
    </script>

    <style>
        body {
        font-family: 'DM Sans', sans-serif;
        }

        #sidebar {
        transition: transform .25s ease;
        }

        #overlay {
        display: none;
        }

        #overlay.open {
        display: block;
        }

        @@media (max-width: 768px) {

        #sidebar {
        transform: translateX(-100%);
        }

        #sidebar.open {
        transform: translateX(0);
        }

        #main-wrapper {
        margin-left: 0 !important;
        }
        }
    </style>
</head>

<body class="bg-gray-50 text-gray-900">

    <!-- MOBILE TOPBAR -->
    <div class="md:hidden fixed top-0 left-0 right-0 h-14 bg-[#0F1117] flex items-center px-4 gap-3 z-50 border-b border-white/5">

        <button onclick="toggleSidebar()"
                class="text-white p-2 rounded-lg hover:bg-white/10 transition">
            <svg width="20"
                 height="20"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2"
                 viewBox="0 0 24 24">
                <line x1="3" y1="6" x2="21" y2="6" />
                <line x1="3" y1="12" x2="21" y2="12" />
                <line x1="3" y1="18" x2="21" y2="18" />
            </svg>
        </button>

        <span class="text-white text-sm font-semibold tracking-wide">
            Medlink
        </span>
    </div>

    <!-- OVERLAY -->
    <div id="overlay"
         onclick="toggleSidebar()"
         class="fixed inset-0 bg-black/50 z-40 md:hidden">
    </div>

    <!-- SIDEBAR -->
    <aside id="sidebar"
           class="fixed top-0 left-0 w-[250px] h-screen bg-[#0F1117] flex flex-col z-50 border-r border-white/[0.04]">

        <!-- BRAND -->
        <div class="px-5 py-5 border-b border-white/[0.06]">

            <a asp-controller="Home"
               asp-action="Index"
               class="flex items-center gap-3 no-underline">

                <div class="w-10 h-10 rounded-2xl bg-blue-600 flex items-center justify-center shadow-lg shadow-blue-600/20">

                    <svg width="18"
                         height="18"
                         fill="none"
                         stroke="white"
                         stroke-width="2"
                         viewBox="0 0 24 24">

                        <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
                    </svg>
                </div>

                <div>
                    <div class="text-white text-sm font-semibold leading-tight">
                        Medlink
                    </div>

                    <div class="text-gray-500 text-[11px]">
                        Dialysis Center
                    </div>
                </div>
            </a>
        </div>

        <!-- NAVIGATION -->
        <nav class="flex-1 overflow-y-auto px-3 py-4">

            <!-- SECTION -->
            <div class="text-[10px] font-semibold text-white/25 uppercase tracking-[0.2em] px-3 pb-2">
                Main
            </div>

            <!-- DASHBOARD -->
            <a asp-controller="Home"
               asp-action="Index"
               class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm transition-all mb-1
                @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home"
               ? "bg-white/10 text-white"
               : "text-gray-400 hover:bg-white/5 hover:text-white")">

                <svg width="18"
                     height="18"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     viewBox="0 0 24 24">

                    <rect x="3" y="3" width="7" height="7" />
                    <rect x="14" y="3" width="7" height="7" />
                    <rect x="14" y="14" width="7" height="7" />
                    <rect x="3" y="14" width="7" height="7" />
                </svg>

                Dashboard
            </a>

            <!-- PATIENTS -->
            <a asp-controller="Patients"
               asp-action="Index"
               class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm transition-all mb-1
                @(ViewContext.RouteData.Values["controller"]?.ToString() == "Patients"
               ? "bg-white/10 text-white"
               : "text-gray-400 hover:bg-white/5 hover:text-white")">

                <svg width="18"
                     height="18"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     viewBox="0 0 24 24">

                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                    <circle cx="9" cy="7" r="4" />
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                    <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                </svg>

                Patients
            </a>

            <!-- INVENTORY -->
            @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="InventoryItems"
                    asp-action="Index"
                    class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm transition-all mb-1
                @(ViewContext.RouteData.Values["controller"]?.ToString() == "InventoryItems"
              ? "bg-white/10 text-white"
              : "text-gray-400 hover:bg-white/5 hover:text-white")">

                        <svg width="18"
                        height="18"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        viewBox="0 0 24 24">

                            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
                            <polyline points="3.27 6.96 12 12.01 20.73 6.96" />
                            <line x1="12" y1="22.08" x2="12" y2="12" />
                        </svg>

                        Inventory
                    </a>
                }

            <!-- PHILHEALTH -->
            @if (User.IsInRole("Admin"))
            {
                <!-- ENABLED FOR ADMIN -->
                <a asp-controller="PhilhealthRequirements"
                   asp-action="Index"
                   class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm transition-all mb-1
                    @(ViewContext.RouteData.Values["controller"]?.ToString() == "PhilhealthRequirements"
                   ? "bg-white/10 text-white"
                   : "text-gray-400 hover:bg-white/5 hover:text-white")">

                    <svg width="18"
                         height="18"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         viewBox="0 0 24 24">

                        <path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2" />
                        <rect x="9" y="3" width="6" height="4" rx="1" />
                    </svg>

                    PhilHealth Tracker
                </a>
            }
            else
            {
                <!-- DISABLED FOR NURSE -->
                <div class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-gray-500 text-sm opacity-40 cursor-not-allowed select-none mb-1">

                    <svg width="18"
                         height="18"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         viewBox="0 0 24 24">

                        <path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2" />
                        <rect x="9" y="3" width="6" height="4" rx="1" />
                    </svg>

                    <span>PhilHealth Tracker</span>

                    <span class="ml-auto text-[10px] font-semibold px-2 py-0.5 rounded-full bg-gray-700 text-gray-300">
                        Restricted
                    </span>
                </div>
            }

            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="UserManagement"
                   asp-action="Index"
                   class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm transition-all mb-1
                    @(ViewContext.RouteData.Values["controller"]?.ToString() == "UserManagement"
                   ? "bg-white/10 text-white"
                   : "text-gray-400 hover:bg-white/5 hover:text-white")">

                    <!-- ICON -->
                    <svg width="18"
                         height="18"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         viewBox="0 0 24 24">

                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                        <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                    </svg>

                    User Management

                    <!-- ADMIN BADGE -->
                    <span class="ml-auto text-[10px] font-semibold px-2 py-0.5 rounded-full bg-blue-600 text-white">
                        Admin
                    </span>
                </a>
            }

            <!-- COMING SOON -->
            <div class="text-[10px] font-semibold text-white/25 uppercase tracking-[0.2em] px-3 pt-6 pb-2">
                Coming Soon
            </div>

            <!-- LAB -->
            <div class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-gray-500 text-sm opacity-50 cursor-not-allowed">

                <svg width="18"
                     height="18"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     viewBox="0 0 24 24">

                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                </svg>

                <span>Lab Results</span>

                <span class="ml-auto bg-blue-600 text-white text-[10px] font-semibold px-2 py-0.5 rounded-full">
                    Soon
                </span>
            </div>

            <!-- BILLING -->
            <div class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-gray-500 text-sm opacity-50 cursor-not-allowed">

                <svg width="18"
                     height="18"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     viewBox="0 0 24 24">

                    <line x1="12" y1="1" x2="12" y2="23" />
                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                </svg>

                <span>Billing</span>

                <span class="ml-auto bg-blue-600 text-white text-[10px] font-semibold px-2 py-0.5 rounded-full">
                    Soon
                </span>
            </div>

            <!-- MACHINES -->
            <div class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-gray-500 text-sm opacity-50 cursor-not-allowed">

                <svg width="18"
                     height="18"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     viewBox="0 0 24 24">

                    <circle cx="12" cy="12" r="3" />
                    <path d="M19.07 4.93a10 10 0 0 1 0 14.14M4.93 4.93a10 10 0 0 0 0 14.14" />
                </svg>

                <span>Machines</span>

                <span class="ml-auto bg-blue-600 text-white text-[10px] font-semibold px-2 py-0.5 rounded-full">
                    Soon
                </span>
            </div>

        </nav>

        <!-- USER SECTION -->
        @if (User.Identity!.IsAuthenticated)
        {
            <div class="px-3 pb-4">

                <!-- USER CARD -->
                <div class="flex items-center gap-3 p-3 rounded-2xl bg-white/[0.04] border border-white/[0.05]">

                    <!-- AVATAR -->
                    <div class="w-11 h-11 rounded-full bg-blue-600 flex items-center justify-center text-white font-semibold shadow-lg shadow-blue-600/20">
                        @User.Identity.Name?.Substring(0, 1).ToUpper()
                    </div>

                    <!-- INFO -->
                    <div class="flex-1 overflow-hidden">

                        <div class="text-sm font-medium text-white truncate">
                            @User.Identity.Name
                        </div>

                        <div class="text-[11px] text-gray-500">
                            Logged in
                        </div>
                    </div>
                </div>

                <!-- LOGOUT -->
                <a href="/Account/Logout"
                   class="mt-3 flex items-center justify-center gap-2 w-full px-4 py-3 rounded-2xl bg-red-500/10 text-red-400 hover:bg-red-500 hover:text-white transition-all duration-200 text-sm font-medium no-underline">

                    <svg width="16"
                         height="16"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         viewBox="0 0 24 24">

                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                        <polyline points="16 17 21 12 16 7" />
                        <line x1="21" y1="12" x2="9" y2="12" />
                    </svg>

                    Logout
                </a>
            </div>
        }

        <!-- FOOTER -->
        <div class="px-3 py-4 border-t border-white/[0.06]">

            <div class="flex items-center gap-3 px-3 py-2">

                <div class="w-2.5 h-2.5 rounded-full bg-green-500 shadow-[0_0_0_4px_rgba(34,197,94,0.15)]">
                </div>

                <div class="text-xs text-gray-500 leading-tight">

                    <span class="text-white/70 font-medium">
                        System Online
                    </span>

                    <br />

                    v1.0 · @DateTime.Now.ToString("MMM yyyy")
                </div>
            </div>
        </div>
    </aside>

    <!-- DESKTOP TOPBAR -->
    <div class="hidden md:flex fixed top-0 left-[250px] right-0 h-14 bg-white border-b border-gray-200 items-center px-7 gap-4 z-40">

        <span class="text-sm font-semibold text-gray-900 flex-1">
            @(ViewData["Title"] ?? "Dashboard")
        </span>

        <span class="text-sm text-gray-400">
            @DateTime.Now.ToString("ddd, MMM dd yyyy")
        </span>

        <div class="w-px h-5 bg-gray-200"></div>

        <div class="w-9 h-9 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center text-sm font-semibold">
            M
        </div>
    </div>

    <!-- MAIN CONTENT -->
    <div id="main-wrapper"
         class="ml-[250px] pt-14 min-h-screen flex flex-col">

        <div class="p-8 flex-1">
            @RenderBody()
        </div>
    </div>

    <!-- SCRIPTS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        function toggleSidebar() {

        document.getElementById('sidebar').classList.toggle('open');

        document.getElementById('overlay').classList.toggle('open');
        }
    </script>

</body>
</html>