@model MedlinkDialysisCenter.ViewModels.PhConsumptionIndexViewModel
@{
    ViewData["Title"] = "PhilHealth Session Monitor";
}

<div class="flex items-center justify-between mb-6">
    <h1 class="text-xl font-bold text-gray-800">PhilHealth Session Monitor</h1>
    <div class="flex items-center gap-3">
        <label class="text-sm text-gray-500">Year:</label>
        <select id="yearSelect" onchange="window.location.href='?year='+this.value"
                class="border border-gray-200 rounded-lg px-3 py-1.5 text-sm text-gray-700 focus:ring-2 focus:ring-blue-500 focus:outline-none">
            @for (int y = DateTime.Now.Year; y >= DateTime.Now.Year - 3; y--)
            {
                <option value="@y" selected="@(y == Model.YearFilter)">@y</option>
            }
        </select>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="mb-4 p-3 bg-green-50 border border-green-200 text-green-700 rounded-lg text-sm">
        @TempData["Success"]
    </div>
}

<!-- Stats Summary -->
<div class="grid grid-cols-3 gap-4 mb-6">
    <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-4">
        <p class="text-xs text-gray-400 mb-1">Total Patients</p>
        <p class="text-2xl font-bold text-gray-800">@Model.PatientSummaries.Count</p>
    </div>
    <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-4">
        <p class="text-xs text-gray-400 mb-1">Low / Exhausted</p>
        <p class="text-2xl font-bold text-red-500">@Model.PatientSummaries.Count(x => x.IsWarning || x.IsExhausted)</p>
    </div>
    <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-4">
        <p class="text-xs text-gray-400 mb-1">Total Sessions Used</p>
        <p class="text-2xl font-bold text-blue-600">@Model.PatientSummaries.Sum(x => x.TotalUsed)</p>
    </div>
</div>

<!-- Search + Table -->
<div class="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden">

    <!-- Search Bar -->
    <div class="px-5 py-4 border-b border-gray-100 flex items-center gap-3">
        <div class="relative flex-1 max-w-sm">
            <svg class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <circle cx="11" cy="11" r="8" />
                <line x1="21" y1="21" x2="16.65" y2="16.65" />
            </svg>
            <input type="text" id="searchInput" placeholder="Search patient name..."
                   oninput="filterTable()"
                   class="w-full pl-9 pr-4 py-2 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none focus:border-transparent" />
        </div>
        <div class="flex gap-2">
            <button onclick="filterStatus('all')" id="btn-all"
                    class="status-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-gray-800 text-white transition">
                All
            </button>
            <button onclick="filterStatus('ok')" id="btn-ok"
                    class="status-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-gray-100 text-gray-600 hover:bg-gray-200 transition">
                OK
            </button>
            <button onclick="filterStatus('warning')" id="btn-warning"
                    class="status-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-gray-100 text-gray-600 hover:bg-gray-200 transition">
                Low
            </button>
            <button onclick="filterStatus('exhausted')" id="btn-exhausted"
                    class="status-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-gray-100 text-gray-600 hover:bg-gray-200 transition">
                Exhausted
            </button>
        </div>
    </div>

    <!-- Table -->
    <table class="w-full text-sm" id="patientTable">
        <thead class="bg-gray-50 text-xs text-gray-400 uppercase tracking-wide">
            <tr>
                <th class="px-5 py-3 text-left">Patient</th>
                <th class="px-5 py-3 text-left">Sessions Used</th>
                <th class="px-5 py-3 text-left w-48">Progress</th>
                <th class="px-5 py-3 text-center">Own Center</th>
                <th class="px-5 py-3 text-center">Transferee</th>
                <th class="px-5 py-3 text-center">Remaining</th>
                <th class="px-5 py-3 text-center">Status</th>
                <th class="px-5 py-3"></th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-50" id="tableBody">
            @foreach (var s in Model.PatientSummaries)
            {
                var statusKey = s.IsExhausted ? "exhausted" : s.IsWarning ? "warning" : "ok";
                var badgeClass = s.IsExhausted
                    ? "bg-red-100 text-red-600"
                    : s.IsWarning
                        ? "bg-yellow-100 text-yellow-600"
                        : "bg-green-100 text-green-600";
                var badgeLabel = s.IsExhausted ? "Exhausted" : s.IsWarning ? "Low" : "OK";
                var barColor = s.IsExhausted ? "bg-red-500" : s.IsWarning ? "bg-yellow-400" : "bg-blue-500";
                var pct = Math.Min(s.UsagePercent, 100);

                <tr class="hover:bg-gray-50 transition patient-row" data-name="@s.PatientName.ToLower()" data-status="@statusKey">
                    <td class="px-5 py-3.5">
                        <p class="font-medium text-gray-800">@s.PatientName</p>
                        <p class="text-xs text-gray-400">ID: @s.PatientId</p>
                    </td>
                    <td class="px-5 py-3.5">
                        <span class="font-semibold text-gray-700">@s.TotalUsed</span>
                        <span class="text-gray-400">/ 156</span>
                    </td>
                    <td class="px-5 py-3.5">
                        <div class="w-full bg-gray-100 rounded-full h-2">
                            <div class="@barColor h-2 rounded-full" style="width:@(pct)%"></div>
                        </div>
                        <p class="text-xs text-gray-400 mt-1">@s.UsagePercent%</p>
                    </td>
                    <td class="px-5 py-3.5 text-center text-gray-600">@s.SessionsFromOwnCenter</td>
                    <td class="px-5 py-3.5 text-center text-gray-600">@s.SessionsFromOtherCenter</td>
                    <td class="px-5 py-3.5 text-center font-semibold @(s.IsExhausted ? "text-red-500" : s.IsWarning ? "text-yellow-500" : "text-green-600")">
                        @s.Remaining
                    </td>
                    <td class="px-5 py-3.5 text-center">
                        <span class="text-xs font-medium px-2.5 py-1 rounded-full @badgeClass">@badgeLabel</span>
                    </td>
                    <td class="px-5 py-3.5">
                        <div class="flex items-center gap-2 justify-end">
                            <a asp-action="Details" asp-route-id="@s.PatientId" asp-route-year="@Model.YearFilter"
                               class="text-xs text-gray-500 hover:text-gray-800 border border-gray-200 px-3 py-1.5 rounded-lg hover:border-gray-300 transition whitespace-nowrap">
                                View
                            </a>
                            @if (!s.IsExhausted)
                            {
                                <a asp-action="AddSession" asp-route-patientId="@s.PatientId"
                                   class="text-xs text-white bg-blue-600 hover:bg-blue-700 px-3 py-1.5 rounded-lg transition whitespace-nowrap">
                                    + Session
                                </a>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Empty State -->
    <div id="emptyState" class="hidden py-16 text-center text-gray-400 text-sm">
        No patients found.
    </div>

    <!-- Row Count -->
    <div class="px-5 py-3 border-t border-gray-100 text-xs text-gray-400">
        Showing <span id="rowCount">@Model.PatientSummaries.Count</span> of @Model.PatientSummaries.Count patients
    </div>
</div>

<script>
    let activeStatus = 'all';

    function filterTable() {
        const search = document.getElementById('searchInput').value.toLowerCase();
        const rows = document.querySelectorAll('.patient-row');
        let visible = 0;

        rows.forEach(row => {
            const name = row.dataset.name;
            const status = row.dataset.status;
            const matchSearch = name.includes(search);
            const matchStatus = activeStatus === 'all' || status === activeStatus;

            if (matchSearch && matchStatus) {
                row.classList.remove('hidden');
                visible++;
            } else {
                row.classList.add('hidden');
            }
        });

        document.getElementById('rowCount').textContent = visible;
        document.getElementById('emptyState').classList.toggle('hidden', visible > 0);
    }

    function filterStatus(status) {
        activeStatus = status;

        document.querySelectorAll('.status-btn').forEach(btn => {
            btn.classList.remove('bg-gray-800', 'text-white');
            btn.classList.add('bg-gray-100', 'text-gray-600');
        });

        const active = document.getElementById('btn-' + status);
        active.classList.add('bg-gray-800', 'text-white');
        active.classList.remove('bg-gray-100', 'text-gray-600');

        filterTable();
    }
</script>
