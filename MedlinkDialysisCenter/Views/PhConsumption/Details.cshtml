@model MedlinkDialysisCenter.ViewModels.PhSummaryViewModel
@{
    ViewData["Title"] = "Session Details";
    var barColor = Model.IsExhausted ? "bg-red-500" : Model.IsWarning ? "bg-yellow-400" : "bg-blue-500";
    var pct = Math.Min(Model.UsagePercent, 100);
}

@* Back + Header *@
<div class="flex items-center gap-3 mb-6">
    <a asp-action="Index" class="w-8 h-8 flex items-center justify-center rounded-lg hover:bg-gray-100 text-gray-400 hover:text-gray-700 transition">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
    </a>
    <div>
        <h1 class="text-xl font-bold text-gray-800 leading-tight">@Model.PatientName</h1>
        <p class="text-xs text-gray-400">Year covered: @Model.YearCovered</p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="mb-4 p-3 bg-green-50 border border-green-200 text-green-700 rounded-lg text-sm">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="mb-4 p-3 bg-red-50 border border-red-200 text-red-700 rounded-lg text-sm">@TempData["Error"]</div>
}

@* Summary Card *@
<div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6 mb-5">
    <div class="grid grid-cols-4 gap-4 mb-5">
        <div class="bg-gray-50 rounded-xl p-4 text-center">
            <p class="text-2xl font-bold text-gray-800">@Model.TotalUsed</p>
            <p class="text-xs text-gray-400 mt-1">Total Used</p>
        </div>
        <div class="bg-gray-50 rounded-xl p-4 text-center">
            <p class="text-2xl font-bold @(Model.IsExhausted ? "text-red-500" : Model.IsWarning ? "text-yellow-500" : "text-green-600")">
                @Model.Remaining
            </p>
            <p class="text-xs text-gray-400 mt-1">Remaining</p>
        </div>
        <div class="bg-gray-50 rounded-xl p-4 text-center">
            <p class="text-2xl font-bold text-blue-600">@Model.SessionsFromOwnCenter</p>
            <p class="text-xs text-gray-400 mt-1">Own Center</p>
        </div>
        <div class="bg-gray-50 rounded-xl p-4 text-center">
            <p class="text-2xl font-bold text-indigo-600">@Model.SessionsFromOtherCenter</p>
            <p class="text-xs text-gray-400 mt-1">Transferee</p>
        </div>
    </div>

    @* Progress Bar *@
    <div class="w-full bg-gray-100 rounded-full h-3 mb-2 overflow-hidden">
        <div class="@barColor h-3 rounded-full transition-all duration-500" style="width:@(pct)%"></div>
    </div>
    <div class="flex justify-between text-xs text-gray-400">
        <span>@Model.UsagePercent% used</span>
        <span>@Model.TotalUsed / 156 sessions</span>
    </div>

    @if (Model.IsExhausted)
    {
        <div class="mt-4 flex items-center gap-2 p-3 bg-red-50 border border-red-100 text-red-700 text-sm rounded-lg">
            <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="10" />
                <line x1="12" y1="8" x2="12" y2="12" />
                <line x1="12" y1="16" x2="12.01" y2="16" />
            </svg>
            PhilHealth sessions fully exhausted for @Model.YearCovered.
        </div>
    }
    else if (Model.IsWarning)
    {
        <div class="mt-4 flex items-center gap-2 p-3 bg-yellow-50 border border-yellow-100 text-yellow-700 text-sm rounded-lg">
            <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
                <line x1="12" y1="9" x2="12" y2="13" />
                <line x1="12" y1="17" x2="12.01" y2="17" />
            </svg>
            Only <strong>@Model.Remaining</strong> session(s) remaining — running low!
        </div>
    }
</div>

@* Action Buttons *@
@if (!Model.IsExhausted)
{
    <div class="flex gap-3 mb-5">
        <a asp-action="AddSession" asp-route-patientId="@Model.PatientId"
           class="inline-flex items-center gap-2 px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg transition shadow-sm shadow-blue-200">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="10" />
                <line x1="12" y1="8" x2="12" y2="16" />
                <line x1="8" y1="12" x2="16" y2="12" />
            </svg>
            Add Session (Own Center)
        </a>
        <a asp-action="AddTransferee" asp-route-patientId="@Model.PatientId"
           class="inline-flex items-center gap-2 px-4 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium rounded-lg transition shadow-sm shadow-indigo-200">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <polyline points="17 1 21 5 17 9" />
                <path d="M3 11V9a4 4 0 0 1 4-4h14" />
                <polyline points="7 23 3 19 7 15" />
                <path d="M21 13v2a4 4 0 0 1-4 4H3" />
            </svg>
            Add Transferee Sessions
        </a>
    </div>
}

@* Session History Table *@
<div class="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-100 flex items-center justify-between">
        <h2 class="font-semibold text-gray-700 text-sm">Session History</h2>
        <span class="text-xs text-gray-400">@Model.History.Count record(s)</span>
    </div>

    @if (!Model.History.Any())
    {
        <div class="py-16 text-center text-gray-400">
            <svg class="w-10 h-10 mx-auto mb-3 text-gray-200" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2" />
                <rect x="9" y="3" width="6" height="4" rx="1" />
            </svg>
            <p class="text-sm">No session records for @Model.YearCovered.</p>
        </div>
    }
    else
    {
        <table class="w-full text-sm">
            <thead class="bg-gray-50 text-xs text-gray-400 uppercase tracking-wide">
                <tr>
                    <th class="px-5 py-3 text-left">Date</th>
                    <th class="px-5 py-3 text-left">Type</th>
                    <th class="px-5 py-3 text-left">Center</th>
                    <th class="px-5 py-3 text-center">Sessions</th>
                    <th class="px-5 py-3 text-left">Remarks</th>
                    <th class="px-5 py-3 text-left">Recorded By</th>
                    <th class="px-5 py-3"></th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-50">
                @foreach (var h in Model.History)
                {
                    <tr class="hover:bg-gray-50 transition">
                        <td class="px-5 py-3.5 text-gray-700 font-medium">@h.SessionDate.ToString("MMM dd, yyyy")</td>
                        <td class="px-5 py-3.5">
                            @if (h.ConsumptionType == MedlinkDialysisCenter.Enums.PhConsumptionType.OtherCenter)
                            {
                                <span class="inline-flex items-center gap-1 px-2.5 py-1 bg-indigo-50 text-indigo-600 rounded-full text-xs font-medium">
                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <polyline points="17 1 21 5 17 9" />
                                        <path d="M3 11V9a4 4 0 0 1 4-4h14" />
                                    </svg>
                                    Transferee
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center gap-1 px-2.5 py-1 bg-blue-50 text-blue-600 rounded-full text-xs font-medium">
                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
                                    </svg>
                                    Own Center
                                </span>
                            }
                        </td>
                        <td class="px-5 py-3.5 text-gray-500">@(string.IsNullOrEmpty(h.CenterName) ? "—" : h.CenterName)</td>
                        <td class="px-5 py-3.5 text-center">
                            <span class="font-semibold text-gray-800">@h.SessionsConsumed</span>
                        </td>
                        <td class="px-5 py-3.5 text-gray-400 text-xs">@(string.IsNullOrEmpty(h.Remarks) ? "—" : h.Remarks)</td>
                        <td class="px-5 py-3.5 text-gray-400 text-xs">@h.CreatedBy</td>
                        <td class="px-5 py-3.5">
                            <div class="flex items-center gap-3 justify-end">
                                <a asp-action="Edit" asp-route-id="@h.Id"
                                   class="text-xs text-blue-600 hover:text-blue-800 font-medium transition">Edit</a>
                                <button type="button"
                                        onclick="openDeleteModal('@h.Id', '@Model.PatientId')"
                                        class="text-xs text-red-500 hover:text-red-700 font-medium transition">
                                    Delete
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    @* Delete Confirmation Modal *@
    <div id="deleteModal" class="fixed inset-0 z-50 hidden flex items-center justify-center">
        @* Backdrop *@
        <div class="absolute inset-0 bg-black/30 backdrop-blur-sm" onclick="closeDeleteModal()"></div>

        @* Dialog *@
        <div class="relative bg-white rounded-2xl shadow-xl border border-gray-100 w-full max-w-sm mx-4 p-6">
            <div class="flex items-center justify-center w-12 h-12 rounded-full bg-red-50 mx-auto mb-4">
                <svg class="w-6 h-6 text-red-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M1 7h22M8 7V4a1 1 0 011-1h6a1 1 0 011 1v3" />
                </svg>
            </div>

            <h3 class="text-base font-semibold text-gray-800 text-center mb-1">Delete Session Record</h3>
            <p class="text-sm text-gray-400 text-center mb-6">
                This action cannot be undone. Are you sure you want to delete this record?
            </p>

            <div class="flex gap-3">
                <button type="button" onclick="closeDeleteModal()"
                        class="flex-1 px-4 py-2.5 text-sm font-medium text-gray-600 bg-gray-100 hover:bg-gray-200 rounded-lg transition">
                    Cancel
                </button>

                <form id="deleteForm" asp-action="Delete" method="post" class="flex-1">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="deleteId" name="id" />
                    <input type="hidden" id="deletePatientId" name="patientId" />
                    <button type="submit"
                            class="w-full px-4 py-2.5 text-sm font-medium text-white bg-red-500 hover:bg-red-600 rounded-lg transition shadow-sm shadow-red-200">
                        Yes, Delete
                    </button>
                </form>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
                function openDeleteModal(id, patientId) {
                    document.getElementById('deleteId').value = id;
                    document.getElementById('deletePatientId').value = patientId;
                    document.getElementById('deleteModal').classList.remove('hidden');
                }

                function closeDeleteModal() {
                    document.getElementById('deleteModal').classList.add('hidden');
                }

                // Close on Escape key
                document.addEventListener('keydown', function (e) {
                    if (e.key === 'Escape') closeDeleteModal();
                });
        </script>
    }
</div>
