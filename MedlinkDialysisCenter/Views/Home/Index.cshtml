@{
    ViewData["Title"] = "Dashboard";
}

@using MedlinkDialysisCenter.Data
@inject AppDbContext _db

@{
    var today = DateTime.Today;

    var totalPatients = _db.Patients.Where(p => !p.IsDeleted).Count();
    var newThisMonth = _db.Patients.Count(p => p.CreatedAt.Month == DateTime.Now.Month && p.CreatedAt.Year == DateTime.Now.Year);
    var recentPatients = _db.Patients.OrderByDescending(p => p.CreatedAt).Take(5).ToList();

    var birthdayPatients = _db.Patients
        .AsEnumerable()
        .Where(p => p.DateOfBirth.HasValue && p.DateOfBirth.Value.Month == today.Month && p.DateOfBirth.Value.Day == today.Day)
        .ToList();
}

<!-- Header -->
<div class="flex items-end justify-between mb-7 pt-1 flex-wrap gap-4">
    <div>
        <h1 class="text-2xl font-semibold tracking-tight m-0">
            Good @(DateTime.Now.Hour < 12 ? "morning" : DateTime.Now.Hour < 18 ? "afternoon" : "evening") 👋
        </h1>
        <p class="text-sm text-gray-500 mt-1">Here's what's happening at Medlink Dialysis Center today.</p>
    </div>
    <div class="flex items-center gap-1.5 bg-white border border-gray-200 rounded-full px-4 py-1.5 text-sm text-gray-500 shadow-sm">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
        @DateTime.Now.ToString("dddd, MMMM dd, yyyy")
    </div>
</div>

<!-- Birthday Banner (only shows when there are birthday patients today) -->
@if (birthdayPatients.Any())
{
    <div class="bg-yellow-50 border border-yellow-300 rounded-2xl px-5 py-4 flex items-start gap-3 mb-6 shadow-sm">
        <span class="text-2xl flex-shrink-0 mt-0.5">🎂</span>
        <div class="flex-1">
            <div class="text-sm font-semibold text-yellow-800 mb-1">
                🎉 Birthday Patient@(birthdayPatients.Count > 1 ? "s" : "") Today!
            </div>
            <div class="flex flex-wrap gap-1.5 mb-2">
                @foreach (var p in birthdayPatients)
                {
                    <a asp-controller="Patients" asp-action="Details" asp-route-id="@p.PatientCode"
                       class="inline-flex items-center gap-1.5 bg-yellow-100 border border-yellow-300 text-yellow-800 rounded-full px-3 py-1 text-xs font-semibold no-underline hover:bg-yellow-200 transition-colors">
                        🎁 @p.FullName
                        <span class="text-yellow-500 font-normal">#@p.PatientCode</span>
                    </a>
                }
            </div>
            <div class="text-xs text-yellow-600">
                These patients are celebrating their birthday today and are entitled to a complimentary dialysis session. 🎊
            </div>
        </div>
    </div>
}

<!-- Stat Cards -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">

    <div class="bg-white border border-gray-200 rounded-2xl p-5 shadow-sm flex items-start justify-between hover:shadow-md transition-shadow">
        <div>
            <div class="text-sm text-gray-500 font-medium mb-2">Total Patients</div>
            <div class="text-4xl font-semibold tracking-tight text-blue-600">@totalPatients</div>
            <div class="text-xs text-gray-400 mt-2">All registered patients</div>
        </div>
        <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center flex-shrink-0">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
        </div>
    </div>

    <div class="bg-white border border-gray-200 rounded-2xl p-5 shadow-sm flex items-start justify-between hover:shadow-md transition-shadow">
        <div>
            <div class="text-sm text-gray-500 font-medium mb-2">New This Month</div>
            <div class="text-4xl font-semibold tracking-tight text-green-600">@newThisMonth</div>
            <div class="text-xs text-gray-400 mt-2">@DateTime.Now.ToString("MMMM yyyy")</div>
        </div>
        <div class="w-10 h-10 rounded-xl bg-green-50 text-green-600 flex items-center justify-center flex-shrink-0">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><line x1="19" y1="8" x2="19" y2="14" /><line x1="22" y1="11" x2="16" y2="11" /></svg>
        </div>
    </div>

    <a asp-controller="Patients"
       asp-action="Celebrants"
       class="bg-white border border-gray-200 rounded-2xl p-5 shadow-sm flex items-start justify-between hover:shadow-md transition-all hover:border-yellow-300 no-underline">

        <div>
            <div class="text-sm text-gray-500 font-medium mb-2">
                Birthday
            </div>

            @{
                var birthdayThisMonth = _db.Patients
                    .Count(p => p.DateOfBirth.HasValue &&
                                p.DateOfBirth.Value.Month == today.Month);
            }

            @if (birthdayThisMonth > 0)
            {
                <div class="text-xl font-semibold text-yellow-600 pt-1.5">
                    @DateTime.Now.ToString("MMMM") Celebrants 🎂
                </div>

                <div class="text-xs text-gray-400 mt-2">
                    @birthdayThisMonth celebrant@(birthdayThisMonth > 1 ? "s" : "")
                </div>
            }
            else
            {
                <div class="text-xl font-semibold text-gray-500 pt-1.5">
                    No Celebrants
                </div>

                <div class="text-xs text-gray-400 mt-2">
                    No birthdays this month
                </div>
            }

        </div>

        <div class="w-10 h-10 rounded-xl bg-yellow-50 text-yellow-600 flex items-center justify-center flex-shrink-0">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M12 2C10 5 7 7 7 11a5 5 0 0 0 10 0c0-4-3-6-5-9z" />
                <path d="M12 13v8" />
            </svg>
        </div>
    </a>

</div>

<!-- Two col -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">

    <!-- Recent Patients -->
    <div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden">
        <div class="px-5 py-4 border-b border-gray-100 flex items-center justify-between">
            <span class="text-sm font-semibold">Recent Patients</span>
            <a asp-controller="Patients" asp-action="Index" class="text-sm text-blue-600 font-medium no-underline hover:underline">View all →</a>
        </div>
        @if (!recentPatients.Any())
        {
            <div class="px-5 py-10 text-center text-sm text-gray-400">No patients registered yet.</div>
        }
        else
        {
            @foreach (var p in recentPatients)
            {
                var isBirthday = p.DateOfBirth.HasValue && p.DateOfBirth.Value.Month == today.Month && p.DateOfBirth.Value.Day == today.Day;

                <a asp-controller="Patients" asp-action="Details" asp-route-id="@p.PatientCode"
                   class="flex items-center gap-3 px-5 py-3.5 border-b border-gray-100 last:border-0 hover:bg-slate-50 no-underline text-inherit transition-colors @(isBirthday ? "bg-yellow-50 hover:bg-yellow-100" : "")">
                    <div class="w-9 h-9 rounded-full @(isBirthday ? "bg-yellow-100 text-yellow-700" : "bg-blue-50 text-blue-600") flex items-center justify-center text-xs font-semibold flex-shrink-0">
                        @if (isBirthday)
                        {
                            <span>🎂</span>
                        }
                        else
                        {
                            @p.FirstName[0]
                            @p.LastName[0]
                        }
                    </div>
                    <div>
                        <div class="text-sm font-medium text-gray-900 flex items-center gap-1.5">
                            @p.FullName
                            @if (isBirthday)
                            {
                                <span class="text-xs bg-yellow-100 border border-yellow-300 text-yellow-700 rounded-full px-2 py-0.5 font-medium">🎁 Birthday</span>
                            }
                        </div>
                        <div class="text-xs text-gray-400 font-mono">#@p.PatientCode</div>
                    </div>
                    <div class="text-xs text-gray-400 ml-auto">@p.CreatedAt.ToString("MMM dd")</div>
                </a>
            }
        }
    </div>

    <!-- Quick Actions -->
    <div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden">
        <div class="px-5 py-4 border-b border-gray-100">
            <span class="text-sm font-semibold">Quick Actions</span>
        </div>
        <div class="flex flex-col gap-2.5 p-4">
            <a asp-controller="Patients" asp-action="Create"
               class="flex items-center gap-3 px-4 py-3.5 rounded-xl border-[1.5px] border-gray-200 bg-white no-underline text-gray-900 font-medium text-sm hover:border-blue-500 hover:bg-blue-50 hover:text-blue-600 transition-all">
                <div class="w-9 h-9 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center flex-shrink-0">
                    <svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><line x1="19" y1="8" x2="19" y2="14" /><line x1="22" y1="11" x2="16" y2="11" /></svg>
                </div>
                <div>
                    <div>Register New Patient</div>
                    <div class="text-xs text-gray-400 font-normal mt-0.5">Add a new patient record</div>
                </div>
                <svg class="ml-auto text-gray-400" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 18l6-6-6-6" /></svg>
            </a>

            <a asp-controller="Patients" asp-action="Index"
               class="flex items-center gap-3 px-4 py-3.5 rounded-xl border-[1.5px] border-gray-200 bg-white no-underline text-gray-900 font-medium text-sm hover:border-green-500 hover:bg-green-50 hover:text-green-700 transition-all">
                <div class="w-9 h-9 rounded-lg bg-green-50 text-green-600 flex items-center justify-center flex-shrink-0">
                    <svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
                </div>
                <div>
                    <div>View All Patients</div>
                    <div class="text-xs text-gray-400 font-normal mt-0.5">Browse the patient list</div>
                </div>
                <svg class="ml-auto text-gray-400" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 18l6-6-6-6" /></svg>
            </a>
        </div>
    </div>

</div>

<!-- Info Banner -->
<div class="bg-blue-50 border border-blue-200 rounded-2xl px-5 py-4 flex items-center gap-3">
    <svg class="text-blue-600 flex-shrink-0" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
    <div>
        <div class="text-sm font-semibold text-blue-700 mb-0.5">System Notice</div>
        <div class="text-sm text-blue-500">Medlink Dialysis Center Management System is active. More modules (Sessions, Lab Results, Billing) can be added as the system grows.</div>
    </div>
</div>
