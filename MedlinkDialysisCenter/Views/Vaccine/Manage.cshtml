@model MedlinkDialysisCenter.ViewModels.VaccineViewModel

@{
    ViewData["Title"] = "Vaccinations";
}

<!-- Header -->
<div class="flex items-center justify-between mb-6 pt-1">
    <div class="flex items-center gap-3.5">
        <a asp-controller="Patients" asp-action="Details" asp-route-id="@Model.PatientCode"
           class="inline-flex items-center justify-center w-9 h-9 rounded-xl border-[1.5px] border-gray-200 bg-white text-gray-500 no-underline hover:border-blue-500 hover:text-blue-600 hover:bg-blue-50 transition-all">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 12H5M12 5l-7 7 7 7" /></svg>
        </a>
        <div>
            <h1 class="text-2xl font-semibold tracking-tight m-0">Vaccinations</h1>
            <p class="text-sm text-gray-500 mt-0.5">
                @Model.PatientName
                <span class="font-mono text-gray-400 ml-1">@Model.PatientCode</span>
            </p>
        </div>
    </div>
</div>

<form asp-action="Manage" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="PatientId" />

    <div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden mb-5">
        <div class="px-5 py-3.5 border-b border-gray-100 bg-gray-50 flex items-center justify-between">
            <span class="text-[11px] font-semibold text-gray-400 uppercase tracking-wider">Vaccine Records</span>
            <button type="button" onclick="addVaccineRow()"
                    class="inline-flex items-center gap-1.5 text-xs font-medium text-blue-600 hover:underline">
                <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M12 5v14M5 12h14" />
                </svg>
                Add Vaccine
            </button>
        </div>

        <div id="vaccine-list" class="divide-y divide-gray-100">
            @if (!Model.Vaccines.Any())
            {
                <div id="vaccine-empty" class="px-5 py-10 text-center">
                    <div class="text-3xl mb-2 opacity-30">💉</div>
                    <div class="text-sm font-medium text-gray-500 mb-1">No vaccines recorded</div>
                    <div class="text-xs text-gray-400">Click "Add Vaccine" above to get started.</div>
                </div>
            }

            @for (int i = 0; i < Model.Vaccines.Count; i++)
            {
                <div class="vaccine-row px-5 py-4 grid grid-cols-1 md:grid-cols-3 gap-3 items-end">
                    <input type="hidden" name="Vaccines[@i].PatientVaccineId" value="@Model.Vaccines[i].PatientVaccineId" />
                    <input type="hidden"
                           name="Vaccines[@i].IsDeleted"
                           value="false"
                           class="is-deleted" />

                    <div>
                        <label class="text-xs text-gray-500 font-medium block mb-1">Vaccine Name</label>
                        <input type="text" name="Vaccines[@i].VaccineName"
                               value="@Model.Vaccines[i].VaccineName"
                               placeholder="e.g. Hepatitis B"
                               class="w-full px-3.5 py-2.5 border-[1.5px] border-gray-200 rounded-xl text-sm focus:outline-none focus:border-blue-500 transition-colors" />
                    </div>

                    <div>
                        <label class="text-xs text-gray-500 font-medium block mb-1">Dose</label>
                        <select name="Vaccines[@i].Dose"
                                class="w-full px-3.5 py-2.5 border-[1.5px] border-gray-200 rounded-xl text-sm focus:outline-none focus:border-blue-500 bg-white transition-colors">
                            <option value="First" selected="@(Model.Vaccines[i].Dose == MedlinkDialysisCenter.Models.VaccineDose.First ? "selected" : null)">1st Dose</option>
                            <option value="Second" selected="@(Model.Vaccines[i].Dose == MedlinkDialysisCenter.Models.VaccineDose.Second ? "selected" : null)">2nd Dose</option>
                            <option value="Booster" selected="@(Model.Vaccines[i].Dose == MedlinkDialysisCenter.Models.VaccineDose.Booster ? "selected" : null)">Booster</option>
                        </select>
                    </div>

                    <div class="flex items-end gap-2">
                        <div class="flex-1">
                            <label class="text-xs text-gray-500 font-medium block mb-1">Date Given</label>
                            <input type="date" name="Vaccines[@i].DateGiven"
                                   value="@Model.Vaccines[i].DateGiven?.ToString("yyyy-MM-dd")"
                                   class="w-full px-3.5 py-2.5 border-[1.5px] border-gray-200 rounded-xl text-sm focus:outline-none focus:border-blue-500 transition-colors" />
                        </div>
                        <button type="button" onclick="showDeleteModal(this)"
                                class="flex-shrink-0 inline-flex items-center justify-center w-9 h-9 rounded-xl border-[1.5px] border-gray-200 text-gray-400 hover:border-red-400 hover:text-red-500 hover:bg-red-50 transition-all mb-0.5">
                            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path d="M18 6L6 18M6 6l12 12" />
                            </svg>
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Actions -->
    <div class="flex items-center justify-end gap-2 pb-6">
        <a asp-controller="Patients" asp-action="Details" asp-route-id="@Model.PatientCode"
           class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl border-[1.5px] border-gray-200 bg-white text-sm font-medium text-gray-500 no-underline hover:text-gray-800 hover:border-gray-400 transition-all">
            Cancel
        </a>
        <button type="submit"
                class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-xl bg-blue-600 text-white text-sm font-medium hover:bg-blue-700 transition-colors shadow-sm">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v14a2 2 0 0 1-2 2z" />
                <polyline points="17 21 17 13 7 13 7 21" />
                <polyline points="7 3 7 8 15 8" />
            </svg>
            Save Vaccines
        </button>
    </div>
</form>

<!-- Delete Confirmation Modal -->
<div id="deleteModalOverlay"
     style="display:none; position:fixed; top:0; left:0;
    width:100%; height:100%; background:rgba(0,0,0,.5);
    align-items:center; justify-content:center; z-index:1000;"
     onclick="if(event.target===this) closeDeleteModal()">

    <div style="background:white; border-radius:12px;
        padding:1.5rem; width:90%; max-width:400px;
        box-shadow:0 10px 25px rgba(0,0,0,.15);">

        <h3 style="margin:0 0 .5rem 0; font-size:1.1rem; font-weight:600;">
            Delete vaccine?
        </h3>

        <p style="margin:0; color:#6b7280;">
            Are you sure you want to remove this vaccine record?
        </p>

        <div style="display:flex; justify-content:flex-end; gap:.5rem; margin-top:1.5rem;">
            <button type="button"
                    onclick="closeDeleteModal()"
                    style="padding:.5rem 1rem; border:1px solid #d1d5db;
                background:white; border-radius:.75rem; cursor:pointer;">
                Cancel
            </button>

            <button type="button"
                    onclick="confirmDelete()"
                    style="padding:.5rem 1rem; border:none;
                background:#dc2626; color:white;
                border-radius:.75rem; cursor:pointer;">
                Delete
            </button>
        </div>
    </div>
</div>

<script>
    let vaccineIndex = @Model.Vaccines.Count;
    let rowToDelete = null;

    function addVaccineRow() {

        document.getElementById('vaccine-empty')?.remove();

        const i = vaccineIndex++;

        const row = document.createElement('div');

        row.className =
            'vaccine-row px-5 py-4 grid grid-cols-1 md:grid-cols-3 gap-3 items-end border-t border-gray-100';

        row.innerHTML = `
                <input type="hidden" name="Vaccines[${i}].PatientVaccineId" value="0" />
                <input type="hidden" name="Vaccines[${i}].IsDeleted" value="false" class="is-deleted" />

                <div>
                    <label class="text-xs text-gray-500 font-medium block mb-1">
                        Vaccine Name
                    </label>
                    <input type="text"
                           name="Vaccines[${i}].VaccineName"
                           placeholder="e.g. Hepatitis B"
                           class="w-full px-3.5 py-2.5 border-[1.5px] border-gray-200 rounded-xl text-sm focus:outline-none focus:border-blue-500 transition-colors" />
                </div>

                <div>
                    <label class="text-xs text-gray-500 font-medium block mb-1">
                        Dose
                    </label>
                    <select name="Vaccines[${i}].Dose"
                            class="w-full px-3.5 py-2.5 border-[1.5px] border-gray-200 rounded-xl text-sm focus:outline-none focus:border-blue-500 bg-white transition-colors">
                        <option value="First">1st Dose</option>
                        <option value="Second">2nd Dose</option>
                        <option value="Booster">Booster</option>
                    </select>
                </div>

                <div class="flex items-end gap-2">
                    <div class="flex-1">
                        <label class="text-xs text-gray-500 font-medium block mb-1">
                            Date Given
                        </label>
                        <input type="date"
                               name="Vaccines[${i}].DateGiven"
                               class="w-full px-3.5 py-2.5 border-[1.5px] border-gray-200 rounded-xl text-sm focus:outline-none focus:border-blue-500 transition-colors" />
                    </div>

                    <button type="button"
                            onclick="showDeleteModal(this)"
                            class="flex-shrink-0 inline-flex items-center justify-center w-9 h-9 rounded-xl border-[1.5px] border-gray-200 text-gray-400 hover:border-red-400 hover:text-red-500 hover:bg-red-50 transition-all mb-0.5">

                        <svg width="14" height="14" fill="none" stroke="currentColor"
                             stroke-width="2" viewBox="0 0 24 24">
                            <path d="M18 6L6 18M6 6l12 12" />
                        </svg>

                    </button>
                </div>
            `;

        document.getElementById('vaccine-list').appendChild(row);
    }

    function showDeleteModal(button) {
        rowToDelete = button.closest('.vaccine-row');
        document.getElementById('deleteModalOverlay').style.display = 'flex';
    }

    function closeDeleteModal() {
        rowToDelete = null;
        document.getElementById('deleteModalOverlay').style.display = 'none';
    }

    function confirmDelete() {

        if (!rowToDelete) return;

        const deleteField =
            rowToDelete.querySelector('.is-deleted');

        const vaccineIdInput =
            rowToDelete.querySelector('input[name*="PatientVaccineId"]');

        const vaccineId =
            vaccineIdInput ? parseInt(vaccineIdInput.value) : 0;

        if (vaccineId > 0) {

            if (deleteField) {
                deleteField.value = "true";
            }

            rowToDelete.style.display = 'none';

        } else {

            rowToDelete.remove();
        }

        closeDeleteModal();

        const visibleRows = [...document.querySelectorAll('.vaccine-row')]
            .filter(r => r.style.display !== 'none');

        if (visibleRows.length === 0) {

            const empty = document.createElement('div');

            empty.id = 'vaccine-empty';
            empty.className = 'px-5 py-10 text-center';

            empty.innerHTML = `
                    <div class="text-3xl mb-2 opacity-30">💉</div>
                    <div class="text-sm font-medium text-gray-500 mb-1">
                        No vaccines recorded
                    </div>
                    <div class="text-xs text-gray-400">
                        Click "Add Vaccine" above to get started.
                    </div>
                `;

            document.getElementById('vaccine-list')
                .appendChild(empty);
        }
    }
</script>